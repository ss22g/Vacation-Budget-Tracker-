<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Agri-Predictor Pro — Plan Smarter. Farm Better.</title>

  <!-- Typography: Manrope (Headings & KPIs) + Inter (Body & UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />

  <!-- Lucide Icons & Chart.js -->
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.6.1/dist/chart.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.4.18/purify.min.js"></script>

  <style>
    /* ============================================================
       DESIGN TOKENS — FOREST GREEN, SAFFRON GOLD & CREAM
       ============================================================ */
    :root {
      --forest-950: #06381F;
      --forest-900: #084C29;
      --forest-800: #0B6B3A;
      --forest-700: #0F8046;
      --forest-600: #16A34A;
      --forest-100: #E6F4EC;
      --forest-50:  #F0FAF4;

      --saffron-600: #D97706;
      --saffron-500: #F59E0B;
      --saffron-100: #FEF3C7;
      --saffron-50:  #FFFBEB;

      --bg-page: #F8FAFC;
      --surface: #FFFFFF;
      --surface-subtle: #F3F6F4;
      --surface-hover: #EAF1ED;
      --border: #E2E8F0;
      --border-soft: rgba(11, 107, 58, 0.14);

      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #64748B;

      --ok-bg: #E7F7EE;
      --ok-text: #0B6B3A;
      --warn-bg: #FEF3C7;
      --warn-text: #B45309;
      --danger-bg: #FEE2E2;
      --danger-text: #B91C1C;

      --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
      --shadow-sm: 0 4px 14px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 12px 32px rgba(11, 107, 58, 0.08);
      --shadow-lg: 0 22px 54px rgba(15, 23, 42, 0.16);

      --r-xl: 20px;
      --r-lg: 16px;
      --r-md: 12px;
      --r-sm: 9px;
      --r-pill: 9999px;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    [data-theme="dark"] {
      --bg-page: #0B120E;
      --surface: #121D17;
      --surface-subtle: #18271F;
      --surface-hover: #1F3228;
      --border: rgba(255, 255, 255, 0.09);
      --border-soft: rgba(52, 211, 153, 0.24);

      --forest-100: rgba(16, 185, 129, 0.16);
      --forest-50: rgba(16, 185, 129, 0.10);
      --saffron-100: rgba(245, 158, 11, 0.18);
      --saffron-50: rgba(245, 158, 11, 0.12);

      --text-primary: #F8FAFC;
      --text-secondary: #CBD5E1;
      --text-muted: #94A3B8;

      --ok-bg: rgba(16, 185, 129, 0.16);
      --ok-text: #34D399;
      --warn-bg: rgba(245, 158, 11, 0.18);
      --warn-text: #FBBF24;
      --danger-bg: rgba(239, 68, 68, 0.18);
      --danger-text: #F87171;

      --shadow-sm: 0 6px 20px rgba(0, 0, 0, 0.38);
      --shadow-md: 0 14px 36px rgba(0, 0, 0, 0.50);
      --shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.72);
    }

    /* ============================================================
       BASE & TYPOGRAPHY
       ============================================================ */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background-color: var(--bg-page);
      color: var(--text-primary);
      line-height: 1.5;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    h1, h2, h3, h4, .font-display {
      font-family: "Manrope", "Inter", sans-serif;
      letter-spacing: -0.025em;
    }
    button, input, select { font-family: inherit; }

    /* ============================================================
       1. CONSISTENT DEEP FOREST HEADER
       ============================================================ */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 900;
      background: var(--forest-900);
      border-bottom: 1px solid rgba(255, 255, 255, 0.10);
      color: #FFFFFF;
    }
    .topbar-inner {
      max-width: 1320px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #FFFFFF;
      min-width: 0;
    }
    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .brand-name {
      font-family: "Manrope", sans-serif;
      font-size: 18px;
      font-weight: 800;
      line-height: 1.15;
      color: #FFFFFF;
    }
    .brand-tagline {
      font-size: 11.5px;
      color: rgba(236, 253, 245, 0.78);
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 9px;
      position: relative;
    }
    .loc-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 13px;
      border-radius: var(--r-pill);
      background: rgba(255, 255, 255, 0.11);
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #ECFDF5;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .loc-pill:hover { background: rgba(255, 255, 255, 0.18); }
    .loc-pill svg { color: var(--saffron-500); width: 14px; height: 14px; }

    .lang-switch {
      display: inline-flex;
      background: rgba(0, 0, 0, 0.22);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: var(--r-pill);
      padding: 3px;
      gap: 2px;
    }
    .lang-switch button {
      border: none;
      background: transparent;
      color: rgba(255, 255, 255, 0.78);
      font-size: 11.5px;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: var(--r-pill);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .lang-switch button.active {
      background: var(--forest-700);
      color: #FFFFFF;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
    }

    .top-icon-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.10);
      color: #FFFFFF;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      transition: background 0.2s ease, transform 0.18s ease;
    }
    .top-icon-btn:hover { background: rgba(255, 255, 255, 0.20); transform: translateY(-1px); }
    .top-icon-btn svg { width: 16px; height: 16px; }
    .notif-dot {
      position: absolute;
      top: 7px;
      right: 8px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--saffron-500);
      border: 1.5px solid var(--forest-900);
    }

    .profile-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid rgba(245, 158, 11, 0.75);
      background: #FFFFFF;
      color: var(--forest-900);
      font-family: "Manrope", sans-serif;
      font-weight: 800;
      font-size: 14px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    /* Header Popover Menus */
    .menu-popover {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 280px;
      background: var(--surface);
      color: var(--text-primary);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-lg);
      padding: 12px;
      display: none;
      z-index: 950;
      animation: fadeUp 0.18s var(--ease);
    }
    .menu-popover.open { display: block; }
    .menu-title {
      font-family: "Manrope", sans-serif;
      font-size: 13px;
      font-weight: 800;
      padding: 4px 8px 8px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .menu-item {
      width: 100%;
      border: none;
      background: transparent;
      color: var(--text-primary);
      font-size: 13px;
      font-weight: 600;
      padding: 9px 10px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      text-align: left;
      transition: background 0.15s ease;
    }
    .menu-item:hover { background: var(--surface-subtle); }
    .menu-item svg { width: 16px; height: 16px; color: var(--forest-800); }
    [data-theme="dark"] .menu-item svg { color: #34D399; }
    .notif-item {
      padding: 8px 10px;
      border-radius: 10px;
      background: var(--surface-subtle);
      font-size: 12px;
      color: var(--text-secondary);
      margin-bottom: 6px;
      line-height: 1.4;
    }
    .notif-item strong { color: var(--text-primary); display: block; margin-bottom: 2px; }

    /* ============================================================
       2. GOLDEN-HOUR AGRICULTURAL HERO
       ============================================================ */
    .hero {
      position: relative;
      background-color: var(--forest-950);
      background-image:
        linear-gradient(100deg, rgba(6, 56, 31, 0.94) 0%, rgba(11, 107, 58, 0.80) 48%, rgba(11, 107, 58, 0.34) 100%),
        url("https://images.unsplash.com/photo-1625246333195-78d9c38ad449?auto=format&fit=crop&w=1800&q=80");
      background-size: cover;
      background-position: center 42%;
      color: #FFFFFF;
      padding: 46px 24px 86px;
      overflow: hidden;
    }
    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 82% 28%, rgba(245, 158, 11, 0.24), transparent 46%);
      pointer-events: none;
    }
    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 1320px;
      margin: 0 auto;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 24px;
    }
    .hero-copy { max-width: 640px; }
    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 5px 13px;
      border-radius: var(--r-pill);
      background: rgba(245, 158, 11, 0.18);
      border: 1px solid rgba(245, 158, 11, 0.42);
      color: #FEF3C7;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 14px;
    }
    .hero-eyebrow svg { width: 14px; height: 14px; color: var(--saffron-500); }
    .hero h1 {
      font-size: clamp(30px, 4.4vw, 48px);
      font-weight: 800;
      line-height: 1.08;
      margin-bottom: 12px;
      color: #FFFFFF;
    }
    .hero p {
      font-size: 15.5px;
      color: rgba(236, 253, 245, 0.90);
      max-width: 540px;
      line-height: 1.6;
    }
    .hero-stats {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .hero-stat-pill {
      background: rgba(6, 56, 31, 0.62);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 14px;
      padding: 11px 16px;
      min-width: 132px;
    }
    .hero-stat-val {
      font-family: "Manrope", sans-serif;
      font-size: 18px;
      font-weight: 800;
      color: #FFFFFF;
    }
    .hero-stat-lbl {
      font-size: 11px;
      color: rgba(236, 253, 245, 0.78);
      font-weight: 500;
    }

    /* ============================================================
       MAIN PAGE CONTAINER & OVERLAPPING CARDS
       ============================================================ */
    .main-wrap {
      max-width: 1320px;
      margin: -48px auto 0;
      padding: 0 24px 96px;
      position: relative;
      z-index: 5;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: 1.06fr 1fr;
      gap: 22px;
      align-items: start;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-xl);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .card-elevated { box-shadow: var(--shadow-md); }
    .card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }
    .card-title-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .card-ico {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--forest-100);
      color: var(--forest-800);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    [data-theme="dark"] .card-ico { color: #34D399; }
    .card-ico svg { width: 19px; height: 19px; }
    .card-title {
      font-family: "Manrope", sans-serif;
      font-size: 17px;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.25;
    }
    .card-subtitle {
      font-size: 12.5px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* ============================================================
       3. SOIL CHEMICAL PROFILE CONTROLS
       ============================================================ */
    .tab-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 4px;
      margin-bottom: 16px;
    }
    .tab-btn {
      border: none;
      background: transparent;
      color: var(--text-secondary);
      padding: 9px 10px;
      border-radius: 10px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s var(--ease);
    }
    .tab-btn svg { width: 15px; height: 15px; }
    .tab-btn.active {
      background: var(--forest-800);
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(11, 107, 58, 0.24);
    }

    .status-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 14px;
      border-radius: var(--r-md);
      font-size: 12.5px;
      font-weight: 600;
      margin-bottom: 16px;
    }
    .status-strip.green { background: var(--ok-bg); color: var(--ok-text); border: 1px solid rgba(11, 107, 58, 0.16); }
    .status-strip.saffron { background: var(--saffron-50); color: var(--warn-text); border: 1px solid rgba(245, 158, 11, 0.30); }
    .status-strip.red { background: var(--danger-bg); color: var(--danger-text); border: 1px solid rgba(239, 68, 68, 0.24); }
    .status-strip-left { display: flex; align-items: center; gap: 8px; }
    .status-strip svg { width: 16px; height: 16px; flex-shrink: 0; }
    .conf-badge {
      padding: 2px 9px;
      border-radius: var(--r-pill);
      background: rgba(255, 255, 255, 0.65);
      font-size: 11px;
      font-weight: 800;
    }
    [data-theme="dark"] .conf-badge { background: rgba(0, 0, 0, 0.28); }

    /* Nutrient Individual Cards */
    .nutrient-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 14px;
    }
    .nutrient-card {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 13px 14px;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .nutrient-card:focus-within {
      border-color: var(--forest-800);
      background: var(--surface);
    }
    .nut-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
      gap: 8px;
    }
    .nut-label {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-primary);
    }
    .nut-unit {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 500;
      display: block;
    }
    .nut-input {
      width: 72px;
      padding: 5px 8px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-primary);
      font-family: "Manrope", sans-serif;
      font-size: 14px;
      font-weight: 800;
      text-align: center;
      outline: none;
    }
    .nut-input:focus { border-color: var(--forest-800); box-shadow: 0 0 0 3px var(--forest-100); }

    input[type="range"] {
      width: 100%;
      height: 6px;
      border-radius: var(--r-pill);
      accent-color: var(--forest-800);
      cursor: pointer;
    }
    input[type="range"].saffron-range { accent-color: var(--saffron-500); }

    /* Prominent pH Feature Card */
    .ph-highlight {
      border-radius: 14px;
      padding: 13px 15px;
      background: var(--saffron-50);
      border: 1px solid rgba(245, 158, 11, 0.32);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .ph-highlight.optimal {
      background: var(--forest-50);
      border-color: rgba(11, 107, 58, 0.24);
    }
    .ph-meta {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 12.5px;
      color: var(--text-secondary);
    }
    .ph-meta strong { color: var(--text-primary); display: block; margin-bottom: 1px; }
    .ph-meta svg { width: 18px; height: 18px; color: var(--saffron-600); flex-shrink: 0; margin-top: 2px; }
    .ph-highlight.optimal .ph-meta svg { color: var(--forest-800); }
    .ph-value-pill {
      font-family: "Manrope", sans-serif;
      font-size: 17px;
      font-weight: 800;
      padding: 5px 12px;
      border-radius: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text-primary);
      white-space: nowrap;
    }

    /* Dropdowns & Info Panels */
    .field { margin-bottom: 14px; }
    .field label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }
    .field label svg { width: 14px; height: 14px; color: var(--forest-800); }
    [data-theme="dark"] .field label svg { color: #34D399; }

    select, .text-input {
      width: 100%;
      padding: 10px 13px;
      border-radius: var(--r-md);
      border: 1.5px solid var(--border);
      background: var(--surface-subtle);
      color: var(--text-primary);
      font-size: 13.5px;
      font-weight: 600;
      outline: none;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    select:focus, .text-input:focus {
      background: var(--surface);
      border-color: var(--forest-800);
      box-shadow: 0 0 0 3px var(--forest-100);
    }

    .info-box {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 13px 15px;
      font-size: 12.5px;
      line-height: 1.6;
      color: var(--text-secondary);
      margin-bottom: 12px;
    }
    .info-box strong { color: var(--text-primary); }
    .chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .mini-chip {
      padding: 3px 10px;
      border-radius: var(--r-pill);
      background: var(--forest-100);
      color: var(--ok-text);
      font-size: 11.5px;
      font-weight: 700;
    }

    .alerts-list { display: flex; flex-direction: column; gap: 7px; margin-top: 8px; }
    .alert-row {
      padding: 9px 12px;
      border-radius: 11px;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      font-size: 12.2px;
      color: var(--text-secondary);
    }
    .alert-row strong { color: var(--text-primary); }

    /* ============================================================
       4. VIRTUAL IOT WEATHER CARDS & LOCATION SEARCH
       ============================================================ */
    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: var(--r-pill);
      background: var(--ok-bg);
      color: var(--ok-text);
      font-size: 11.5px;
      font-weight: 700;
      white-space: nowrap;
    }
    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #16A34A;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.55); }
      50%      { box-shadow: 0 0 0 6px rgba(22, 163, 74, 0); }
    }

    .weather-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 14px 0;
    }
    .w-card {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      transition: border-color 0.2s ease;
    }
    .w-card:focus-within { border-color: var(--forest-800); background: var(--surface); }
    .w-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }
    .w-ico {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .w-ico svg { width: 15px; height: 15px; }
    .w-ico.temp { background: #FEF3C7; color: #D97706; }
    .w-ico.hum  { background: #E0F2FE; color: #0284C7; }
    .w-ico.rain { background: #E6F4EC; color: #0B6B3A; }
    [data-theme="dark"] .w-ico.temp { background: rgba(245, 158, 11, 0.18); color: #FBBF24; }
    [data-theme="dark"] .w-ico.hum  { background: rgba(56, 189, 248, 0.18); color: #38BDF8; }
    [data-theme="dark"] .w-ico.rain { background: rgba(16, 185, 129, 0.18); color: #34D399; }

    .w-lbl { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03em; }
    .w-input-row { display: flex; align-items: baseline; gap: 4px; margin-top: 4px; }
    .w-input {
      width: 100%;
      border: none;
      background: transparent;
      color: var(--text-primary);
      font-family: "Manrope", sans-serif;
      font-size: 20px;
      font-weight: 800;
      outline: none;
    }
    .w-unit { font-size: 12px; font-weight: 700; color: var(--text-muted); }

    .btn {
      border: none;
      border-radius: var(--r-md);
      padding: 11px 16px;
      font-size: 13.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s var(--ease);
    }
    .btn svg { width: 16px; height: 16px; }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-forest {
      background: var(--forest-800);
      color: #FFFFFF;
      box-shadow: 0 6px 18px rgba(11, 107, 58, 0.24);
    }
    .btn-forest:hover:not(:disabled) { background: var(--forest-700); transform: translateY(-1px); }
    .btn-saffron {
      background: var(--saffron-500);
      color: #1C1917;
      box-shadow: 0 6px 18px rgba(245, 158, 11, 0.28);
    }
    .btn-saffron:hover:not(:disabled) { background: var(--saffron-600); color: #FFFFFF; transform: translateY(-1px); }
    .btn-outline {
      background: var(--surface);
      color: var(--text-primary);
      border: 1.5px solid var(--border);
    }
    .btn-outline:hover:not(:disabled) { background: var(--surface-subtle); border-color: var(--forest-800); }

    .iot-btn-stack {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 10px;
      margin-bottom: 10px;
    }
    .telemetry-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11.5px;
      color: var(--text-muted);
      padding-top: 6px;
    }
    .telemetry-foot span { display: inline-flex; align-items: center; gap: 6px; }

    /* Dedicated City Search + Master Action Row */
    .action-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 22px;
      margin-top: 22px;
      align-items: stretch;
    }
    .search-bar {
      display: flex;
      gap: 10px;
      margin-bottom: 12px;
    }
    .search-input-wrap {
      position: relative;
      flex: 1;
    }
    .search-input-wrap svg {
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      color: var(--text-muted);
      pointer-events: none;
    }
    .search-input-wrap input { padding-left: 38px; }
    .city-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .city-chip {
      border: 1px solid var(--border);
      background: var(--surface-subtle);
      color: var(--text-secondary);
      border-radius: var(--r-pill);
      padding: 6px 14px;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .city-chip:hover, .city-chip.active {
      background: var(--forest-800);
      color: #FFFFFF;
      border-color: var(--forest-800);
    }

    /* Master Launch Card */
    .launch-card {
      background: var(--forest-900);
      color: #FFFFFF;
      border: 1px solid rgba(255, 255, 255, 0.10);
      border-radius: var(--r-xl);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      box-shadow: var(--shadow-md);
    }
    .launch-card h3 { font-size: 19px; font-weight: 800; color: #FFFFFF; }
    .launch-card p { font-size: 13px; color: rgba(236, 253, 245, 0.82); margin-top: 4px; }
    .btn-master {
      width: 100%;
      padding: 15px 20px;
      border-radius: 14px;
      border: none;
      background: var(--saffron-500);
      color: #111827;
      font-family: "Manrope", sans-serif;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      box-shadow: 0 10px 26px rgba(245, 158, 11, 0.34);
      transition: all 0.22s var(--ease);
    }
    .btn-master:hover:not(:disabled) { background: #FBBF24; transform: translateY(-2px); }
    .btn-master:disabled { opacity: 0.65; cursor: not-allowed; }
    .btn-master svg { width: 18px; height: 18px; }

    /* Trust Strip */
    .trust-strip {
      margin-top: 22px;
      background: var(--forest-950);
      color: #ECFDF5;
      border-radius: var(--r-lg);
      padding: 15px 24px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    .trust-item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      font-size: 13px;
      font-weight: 700;
    }
    .trust-item svg { width: 17px; height: 17px; color: var(--saffron-500); flex-shrink: 0; }

    /* ============================================================
       5. LOADING SKELETON & EMPTY STATE
       ============================================================ */
    .section-divider {
      margin: 34px 0 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .section-divider h2 {
      font-size: 22px;
      font-weight: 800;
      color: var(--text-primary);
    }
    .section-divider span {
      font-size: 12.5px;
      color: var(--text-muted);
      font-weight: 600;
    }

    .empty-state {
      background: var(--surface);
      border: 1.5px dashed var(--border);
      border-radius: var(--r-xl);
      padding: 44px 24px;
      text-align: center;
      color: var(--text-secondary);
    }
    .empty-ico {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: var(--forest-100);
      color: var(--forest-800);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }
    [data-theme="dark"] .empty-ico { color: #34D399; }
    .empty-state h3 { font-size: 18px; color: var(--text-primary); margin-bottom: 6px; }
    .empty-state p { font-size: 13.5px; max-width: 460px; margin: 0 auto 18px; }

    .skeleton-wrap { display: none; }
    .skeleton-wrap.show { display: block; }
    .skel-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 18px; }
    .skel-card {
      height: 112px;
      border-radius: var(--r-lg);
      background: linear-gradient(90deg, var(--surface-subtle) 25%, var(--surface-hover) 50%, var(--surface-subtle) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.3s infinite linear;
    }
    .skel-tall { height: 260px; }
    @keyframes shimmer {
      0%   { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* ============================================================
       6. CROP RECOMMENDATION & FINANCIAL DASHBOARD
       ============================================================ */
    #resultsSection { display: none; animation: fadeUp 0.35s var(--ease); }
    #resultsSection.show { display: block; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Top 3 Strategy Cards */
    .rec-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr 1fr;
      gap: 16px;
      margin-bottom: 20px;
    }
    .rec-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--r-lg);
      padding: 18px 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      text-align: left;
      box-shadow: var(--shadow-sm);
      transition: all 0.22s var(--ease);
    }
    .rec-card:hover { transform: translateY(-2px); border-color: var(--forest-800); }
    .rec-card.active {
      background: var(--forest-800);
      border-color: var(--forest-800);
      color: #FFFFFF;
      box-shadow: 0 12px 28px rgba(11, 107, 58, 0.28);
    }
    .rec-left { display: flex; align-items: center; gap: 13px; }
    .rec-ico {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      background: var(--forest-100);
      color: var(--forest-800);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .rec-card.active .rec-ico {
      background: rgba(255, 255, 255, 0.16);
      color: var(--saffron-500);
    }
    .rec-rank {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .rec-crop {
      font-family: "Manrope", sans-serif;
      font-size: 20px;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.15;
      margin-top: 2px;
    }
    .rec-score {
      font-family: "Manrope", sans-serif;
      font-size: 14px;
      font-weight: 800;
      padding: 6px 12px;
      border-radius: var(--r-pill);
      background: var(--surface-subtle);
      color: var(--text-primary);
      white-space: nowrap;
    }
    .rec-card.active .rec-rank { color: rgba(236, 253, 245, 0.80); }
    .rec-card.active .rec-crop { color: #FFFFFF; }
    .rec-card.active .rec-score { background: rgba(255, 255, 255, 0.20); color: #FFFFFF; }

    /* Crop Identity Banner */
    .crop-banner {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--r-xl);
      padding: 22px 26px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 18px;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
    }
    .crop-banner::before {
      content: "";
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 38%;
      background: linear-gradient(90deg, var(--surface) 0%, rgba(11, 107, 58, 0.06) 100%);
      pointer-events: none;
    }
    .crop-id-left {
      display: flex;
      align-items: center;
      gap: 18px;
      z-index: 2;
    }
    .crop-thumb {
      width: 64px;
      height: 64px;
      border-radius: 18px;
      background: var(--forest-800);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 8px 20px rgba(11, 107, 58, 0.24);
    }
    .crop-thumb svg { width: 30px; height: 30px; color: var(--saffron-500); }
    .crop-id-name {
      font-family: "Manrope", sans-serif;
      font-size: clamp(26px, 3.2vw, 36px);
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.1;
    }
    .crop-id-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }
    .meta-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: var(--r-pill);
      font-size: 12px;
      font-weight: 700;
      background: var(--forest-100);
      color: var(--ok-text);
    }
    .meta-tag.neutral {
      background: var(--surface-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border);
    }
    .voice-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 2;
    }

    /* 3 Financial Metric Cards */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 22px;
    }
    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-top: 3px solid var(--forest-800);
      border-radius: var(--r-lg);
      padding: 20px 22px;
      box-shadow: var(--shadow-sm);
    }
    .kpi-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .kpi-lbl {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-muted);
    }
    .kpi-ico {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: var(--forest-100);
      color: var(--forest-800);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    [data-theme="dark"] .kpi-ico { color: #34D399; }
    .kpi-ico svg { width: 17px; height: 17px; }
    .kpi-val {
      font-family: "Manrope", sans-serif;
      font-size: clamp(24px, 2.6vw, 32px);
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.15;
    }
    .kpi-sub {
      margin-top: 7px;
      font-size: 12px;
      font-weight: 700;
      color: var(--ok-text);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .kpi-sub svg { width: 13px; height: 13px; }

    /* Market Intelligence 2-Col */
    .analytics-grid {
      display: grid;
      grid-template-columns: 1fr 1.22fr;
      gap: 20px;
      margin-bottom: 22px;
    }
    .range-pills {
      display: inline-flex;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: var(--r-pill);
      padding: 3px;
      gap: 2px;
    }
    .range-pills button {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 11.5px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: var(--r-pill);
      cursor: pointer;
    }
    .range-pills button.active {
      background: var(--forest-800);
      color: #FFFFFF;
    }
    .chart-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 10px;
    }
    .peak-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: var(--r-pill);
      background: var(--saffron-100);
      color: var(--warn-text);
      font-family: "Manrope", sans-serif;
      font-size: 12.5px;
      font-weight: 800;
    }
    .sentiment-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: var(--r-pill);
      font-size: 12px;
      font-weight: 700;
    }
    .sentiment-pill.bullish { background: var(--ok-bg); color: var(--ok-text); }
    .sentiment-pill.bearish { background: var(--danger-bg); color: var(--danger-text); }

    .chart-canvas-wrap { position: relative; height: 255px; width: 100%; }

    /* Tables */
    .table-box {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface);
    }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th {
      text-align: left;
      padding: 11px 13px;
      background: var(--surface-subtle);
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    td {
      padding: 11px 13px;
      border-bottom: 1px solid var(--border);
      color: var(--text-primary);
      font-weight: 600;
      white-space: nowrap;
    }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: var(--surface-subtle); }

    /* Explainable AI & Quality Assessment */
    .xai-grid {
      display: grid;
      grid-template-columns: 1.38fr 1fr;
      gap: 20px;
      align-items: start;
    }
    .status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
    .status-dot.ok { background: #16A34A; }
    .status-dot.warn { background: #F59E0B; }
    .status-dot.low { background: #EF4444; }

    .bar-cell { display: flex; align-items: center; gap: 8px; min-width: 115px; }
    .bar-track {
      flex: 1;
      height: 7px;
      border-radius: var(--r-pill);
      background: var(--surface-subtle);
      overflow: hidden;
    }
    .bar-fill { height: 100%; border-radius: var(--r-pill); transition: width 0.55s var(--ease); }
    .bar-fill.ok { background: #16A34A; }
    .bar-fill.warn { background: #F59E0B; }
    .bar-fill.low { background: #EF4444; }
    .bar-num { font-size: 12px; font-weight: 700; width: 34px; text-align: right; }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: var(--r-pill);
      font-size: 11px;
      font-weight: 700;
    }
    .badge.ok { background: var(--ok-bg); color: var(--ok-text); }
    .badge.warn { background: var(--warn-bg); color: var(--warn-text); }
    .badge.low { background: var(--danger-bg); color: var(--danger-text); }

    /* Quality Assessment Card */
    .quality-banner {
      padding: 15px 16px;
      border-radius: 14px;
      font-size: 13.5px;
      font-weight: 600;
      line-height: 1.55;
      margin-bottom: 16px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .quality-banner svg { width: 19px; height: 19px; flex-shrink: 0; margin-top: 2px; }
    .quality-banner.success { background: var(--ok-bg); color: var(--ok-text); border: 1px solid rgba(11, 107, 58, 0.22); }
    .quality-banner.warning { background: var(--warn-bg); color: var(--warn-text); border: 1px solid rgba(245, 158, 11, 0.34); }
    .quality-banner.danger  { background: var(--danger-bg); color: var(--danger-text); border: 1px solid rgba(239, 68, 68, 0.28); }

    .qual-recs-title {
      font-family: "Manrope", sans-serif;
      font-size: 13px;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .qual-recs-title svg { width: 15px; height: 15px; color: var(--forest-800); }
    .qual-rec-list { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .qual-rec-list li {
      padding: 10px 12px;
      border-radius: 12px;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      font-size: 12.5px;
      color: var(--text-secondary);
      line-height: 1.48;
      display: flex;
      align-items: flex-start;
      gap: 9px;
    }
    .qual-rec-list li svg { width: 15px; height: 15px; color: var(--forest-800); flex-shrink: 0; margin-top: 2px; }
    [data-theme="dark"] .qual-rec-list li svg { color: #34D399; }

    /* ============================================================
       7. FLOATING KISAN SAHAYAK AI CHATBOT
       ============================================================ */
    .chat-fab {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 1100;
      border: 1px solid rgba(255, 255, 255, 0.22);
      background: var(--forest-800);
      color: #FFFFFF;
      border-radius: var(--r-pill);
      padding: 13px 20px;
      font-family: "Manrope", sans-serif;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      box-shadow: 0 12px 30px rgba(11, 107, 58, 0.36);
      transition: transform 0.22s var(--ease), background 0.2s ease;
    }
    .chat-fab:hover { background: var(--forest-700); transform: translateY(-2px); }
    .chat-fab svg { width: 18px; height: 18px; color: var(--saffron-500); }

    .chat-drawer {
      position: fixed;
      right: 24px;
      bottom: 84px;
      z-index: 1099;
      width: 405px;
      max-width: calc(100vw - 24px);
      height: 560px;
      max-height: calc(100vh - 110px);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow-lg);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(14px) scale(0.97);
      transform-origin: bottom right;
      transition: all 0.24s var(--ease);
    }
    .chat-drawer.open { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }
    .chat-head {
      background: var(--forest-900);
      color: #FFFFFF;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .chat-head-left { display: flex; align-items: center; gap: 11px; }
    .chat-av {
      width: 36px;
      height: 36px;
      border-radius: 11px;
      background: rgba(255, 255, 255, 0.14);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--saffron-500);
    }
    .chat-h-name { font-family: "Manrope", sans-serif; font-size: 14.5px; font-weight: 800; }
    .chat-h-sub { font-size: 11px; color: rgba(236, 253, 245, 0.80); display: flex; align-items: center; gap: 6px; }
    .chat-h-btns { display: flex; gap: 6px; }
    .chat-h-btn {
      width: 30px;
      height: 30px;
      border-radius: 9px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.10);
      color: #FFFFFF;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .chat-h-btn svg { width: 14px; height: 14px; }
    .chat-h-btn:hover { background: rgba(255, 255, 255, 0.22); }

    .chat-chips {
      padding: 9px 12px;
      display: flex;
      gap: 7px;
      border-bottom: 1px solid var(--border);
      background: var(--surface);
      flex-shrink: 0;
    }
    .chat-chip {
      flex: 1;
      border: 1px solid var(--border);
      background: var(--surface-subtle);
      color: var(--text-primary);
      border-radius: 10px;
      padding: 6px 8px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: all 0.16s ease;
    }
    .chat-chip svg { width: 13px; height: 13px; color: var(--forest-800); }
    [data-theme="dark"] .chat-chip svg { color: #34D399; }
    .chat-chip:hover { background: var(--forest-100); border-color: var(--forest-800); }

    .chat-body {
      flex: 1;
      overflow-y: auto;
      padding: 14px 12px;
      background: var(--bg-page);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .c-row { display: flex; align-items: flex-end; gap: 7px; }
    .c-row.user { justify-content: flex-end; }
    .c-row.bot  { justify-content: flex-start; }
    .c-bot-ico {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--forest-800);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .c-bot-ico svg { width: 13px; height: 13px; }
    .c-bub {
      max-width: 84%;
      padding: 10px 13px;
      font-size: 13px;
      line-height: 1.5;
      word-wrap: break-word;
    }
    .c-bub.bot {
      background: var(--surface);
      color: var(--text-primary);
      border: 1px solid var(--border);
      border-radius: 16px 16px 16px 4px;
      box-shadow: var(--shadow-xs);
    }
    .c-bub.bot strong { color: var(--forest-800); }
    [data-theme="dark"] .c-bub.bot strong { color: #34D399; }
    .c-bub.user {
      background: var(--forest-800);
      color: #FFFFFF;
      border-radius: 16px 16px 4px 16px;
    }
    .c-bub ul { margin: 5px 0 5px 17px; }
    .c-bub p { margin-bottom: 5px; }
    .c-bub p:last-child { margin-bottom: 0; }
    .c-time { display: block; font-size: 9.5px; opacity: 0.65; text-align: right; margin-top: 4px; }

    .typing { display: inline-flex; gap: 4px; padding: 4px 2px; }
    .typing span {
      width: 6px; height: 6px; border-radius: 50%; background: var(--forest-800);
      animation: bounce 1.2s infinite ease-in-out;
    }
    .typing span:nth-child(2) { animation-delay: 0.16s; }
    .typing span:nth-child(3) { animation-delay: 0.32s; }
    @keyframes bounce {
      0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
      40% { transform: scale(1); opacity: 1; }
    }

    .chat-voice {
      padding: 7px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      border-top: 1px solid var(--border);
      background: var(--surface);
    }
    .v-pill {
      border: 1px solid var(--border);
      background: var(--surface-subtle);
      color: var(--text-primary);
      border-radius: 9px;
      padding: 5px 10px;
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .v-pill svg { width: 13px; height: 13px; }
    .v-pill.play { background: var(--forest-800); color: #FFFFFF; border-color: var(--forest-800); }
    .v-lang { width: auto; padding: 4px 8px; font-size: 11px; border-radius: 9px; }

    .chat-form {
      padding: 10px 12px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      border-top: 1px solid var(--border);
      background: var(--surface);
    }
    .chat-form input {
      flex: 1;
      border-radius: var(--r-pill);
      padding: 9px 14px;
      font-size: 13px;
    }
    .send-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: none;
      background: var(--forest-800);
      color: #FFFFFF;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .send-btn svg { width: 16px; height: 16px; }
    .send-btn:hover { background: var(--forest-700); }
    .send-btn:disabled { opacity: 0.55; }


    /* ============================================================
       7B. UPGRADED RICH AI BUBBLES & AUTO-SMART FLOATING NUDGE
       ============================================================ */
    .smart-bubble-wrap {
      position: fixed;
      right: 24px;
      bottom: 84px;
      z-index: 1098;
      width: 318px;
      max-width: calc(100vw - 32px);
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 4px solid var(--forest-800);
      border-radius: 16px;
      padding: 12px 14px;
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: flex-start;
      gap: 11px;
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px) scale(0.96);
      transition: all 0.28s var(--ease);
    }
    .smart-bubble-wrap.show {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
    }
    .smart-bubble-wrap.warn { border-left-color: var(--saffron-500); }
    .smart-bubble-wrap.danger { border-left-color: #EF4444; }
    .smart-bubble-wrap:hover { transform: translateY(-2px) scale(1.01); }

    .sb-ico {
      width: 34px;
      height: 34px;
      border-radius: 11px;
      background: var(--forest-100);
      color: var(--forest-800);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .smart-bubble-wrap.warn .sb-ico { background: var(--saffron-100); color: var(--warn-text); }
    .smart-bubble-wrap.danger .sb-ico { background: var(--danger-bg); color: var(--danger-text); }
    .sb-ico svg { width: 17px; height: 17px; }

    .sb-body { flex: 1; min-width: 0; }
    .sb-eyebrow {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: "Manrope", sans-serif;
      font-size: 11.5px;
      font-weight: 800;
      color: var(--forest-800);
      margin-bottom: 2px;
    }
    [data-theme="dark"] .sb-eyebrow { color: #34D399; }
    .smart-bubble-wrap.warn .sb-eyebrow { color: var(--warn-text); }
    .smart-bubble-wrap.danger .sb-eyebrow { color: var(--danger-text); }
    .sb-text {
      font-size: 12.2px;
      line-height: 1.42;
      color: var(--text-secondary);
      font-weight: 500;
    }
    .sb-cta {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-top: 6px;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--forest-800);
    }
    [data-theme="dark"] .sb-cta { color: #34D399; }
    .sb-cta svg { width: 12px; height: 12px; }
    .sb-close {
      border: none;
      background: transparent;
      color: var(--text-muted);
      width: 22px;
      height: 22px;
      border-radius: 6px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .sb-close:hover { background: var(--surface-subtle); color: var(--text-primary); }
    .sb-close svg { width: 13px; height: 13px; }

    .chat-fab.has-alert {
      box-shadow: 0 12px 30px rgba(11, 107, 58, 0.42), 0 0 0 3px rgba(245, 158, 11, 0.45);
    }
    .fab-badge {
      background: var(--saffron-500);
      color: #111827;
      font-size: 10px;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: var(--r-pill);
      display: none;
    }
    .fab-badge.show { display: inline-block; }

    /* Rich Structured AI Message Styling (Safe Whitelisted Classes) */
    .c-bub.bot {
      max-width: 88%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }
    .ai-h {
      font-family: "Manrope", sans-serif;
      font-size: 13.2px;
      font-weight: 800;
      color: var(--forest-800);
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 10px 0 6px;
      padding-bottom: 4px;
      border-bottom: 1px solid var(--border);
    }
    .ai-h:first-child { margin-top: 0; }
    [data-theme="dark"] .ai-h { color: #34D399; }

    .ai-ul, .ai-ol {
      margin: 5px 0 7px;
      padding-left: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .ai-ul li {
      position: relative;
      padding-left: 15px;
      font-size: 12.8px;
      line-height: 1.48;
      color: var(--text-primary);
    }
    .ai-ul li::before {
      content: "";
      position: absolute;
      left: 2px;
      top: 7px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--forest-800);
    }
    [data-theme="dark"] .ai-ul li::before { background: #34D399; }

    .ai-ol { counter-reset: aiStep; }
    .ai-ol li {
      counter-increment: aiStep;
      position: relative;
      padding-left: 23px;
      font-size: 12.8px;
      line-height: 1.48;
    }
    .ai-ol li::before {
      content: counter(aiStep);
      position: absolute;
      left: 0;
      top: 1px;
      width: 17px;
      height: 17px;
      border-radius: 50%;
      background: var(--forest-100);
      color: var(--forest-800);
      font-family: "Manrope", sans-serif;
      font-size: 10.5px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    [data-theme="dark"] .ai-ol li::before { color: #34D399; }

    .ai-pill {
      display: inline-block;
      padding: 0 6px;
      border-radius: 6px;
      background: var(--saffron-100);
      color: var(--warn-text);
      font-family: "Manrope", sans-serif;
      font-weight: 800;
      font-size: 12px;
    }
    .ai-code {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      padding: 1px 5px;
      border-radius: 6px;
      font-size: 11.5px;
      font-family: ui-monospace, SFMono-Regular, monospace;
    }

    .ai-callout {
      margin: 8px 0;
      padding: 9px 11px;
      border-radius: 11px;
      font-size: 12.4px;
      line-height: 1.48;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-weight: 500;
    }
    .ai-callout svg { width: 15px; height: 15px; flex-shrink: 0; margin-top: 2px; }
    .ai-callout.tip {
      background: var(--ok-bg);
      color: var(--ok-text);
      border: 1px solid rgba(11, 107, 58, 0.20);
    }
    .ai-callout.warn {
      background: var(--warn-bg);
      color: var(--warn-text);
      border: 1px solid rgba(245, 158, 11, 0.34);
    }
    .ai-callout.profit {
      background: linear-gradient(135deg, var(--ok-bg) 0%, var(--saffron-50) 100%);
      color: var(--text-primary);
      border: 1px solid rgba(245, 158, 11, 0.36);
    }
    .ai-callout.profit svg { color: var(--saffron-600); }
    .ai-callout.quote {
      background: var(--surface-subtle);
      color: var(--text-secondary);
      border-left: 3px solid var(--forest-800);
    }

    .c-meta-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-top: 7px;
      padding-top: 5px;
      border-top: 1px dashed var(--border);
    }
    .c-msg-tools { display: inline-flex; gap: 5px; }
    .c-tool-btn {
      border: none;
      background: var(--surface-subtle);
      color: var(--text-muted);
      border-radius: 7px;
      padding: 3px 7px;
      font-size: 10.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
    }
    .c-tool-btn svg { width: 11px; height: 11px; }
    .c-tool-btn:hover { background: var(--forest-100); color: var(--forest-800); }
    [data-theme="dark"] .c-tool-btn:hover { color: #34D399; }

    .m-advisor-dot {
      position: absolute;
      top: 2px;
      right: 14px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--saffron-500);
      display: none;
    }
    .m-advisor-dot.show { display: block; }
    #mNavAdvisor { position: relative; }

    @media (max-width: 820px) {
      .smart-bubble-wrap {
        right: 12px;
        left: 12px;
        width: auto;
        bottom: 76px;
      }
    }

    /* ============================================================
       8. MOBILE BOTTOM NAVIGATION BAR
       ============================================================ */
    .mobile-nav {
      display: none;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1050;
      background: var(--forest-950);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding: 6px 8px calc(8px + env(safe-area-inset-bottom));
      grid-template-columns: repeat(5, 1fr);
      align-items: end;
    }
    .m-nav-btn {
      border: none;
      background: transparent;
      color: rgba(236, 253, 245, 0.72);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      font-size: 10.5px;
      font-weight: 600;
      cursor: pointer;
      padding: 4px 2px;
    }
    .m-nav-btn svg { width: 19px; height: 19px; }
    .m-nav-btn.active { color: #FFFFFF; }
    .m-nav-center {
      margin-top: -22px;
      color: #FFFFFF;
    }
    .m-nav-fab {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--saffron-500);
      color: #111827;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 20px rgba(245, 158, 11, 0.45);
      border: 3px solid var(--forest-950);
      margin-bottom: 2px;
    }
    .m-nav-fab svg { width: 21px; height: 21px; }

    /* ============================================================
       RESPONSIVE LAYOUT
       ============================================================ */
    @media (max-width: 1024px) {
      .grid-2, .action-grid, .analytics-grid, .xai-grid { grid-template-columns: 1fr; }
      .rec-grid, .kpi-grid, .skel-grid-3 { grid-template-columns: 1fr; }
      .trust-strip { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 820px) {
      .topbar-inner { padding: 10px 14px; }
      .brand-tagline, .loc-pill { display: none; }
      .hero { padding: 30px 16px 68px; }
      .main-wrap { margin-top: -38px; padding: 0 14px 104px; }
      .card { padding: 18px 16px; border-radius: 18px; }
      .nutrient-grid, .weather-cards, .iot-btn-stack { grid-template-columns: 1fr; }
      .trust-strip { grid-template-columns: 1fr 1fr; padding: 14px 16px; }
      .mobile-nav { display: grid; }
      .chat-fab { display: none; }
      .chat-drawer {
        right: 12px;
        left: 12px;
        width: auto;
        bottom: 74px;
        height: calc(100vh - 148px);
        max-height: 540px;
      }
    }
    @media print {
      .topbar, .hero, .chat-fab, .chat-drawer, .mobile-nav, .voice-controls { display: none !important; }
      .main-wrap { margin-top: 0; }
    }
  </style>
</head>
<body>

  <!-- ==================== TOP NAVIGATION BAR ==================== -->
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="#top" onclick="scrollToSection('top'); return false;">
        <div class="brand-mark" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M5 19C5 11.5 10.5 5 19 5C19 13.5 12.5 19 5 19Z" fill="#16A34A" stroke="#A7F3D0" stroke-width="1.6"/>
            <path d="M5 19C9.5 14.5 13.5 11 18.5 5.5" stroke="#F59E0B" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="brand-name" data-i18n="brandName">Agri-Predictor Pro</div>
          <div class="brand-tagline" data-i18n="brandTag">AI-Powered Crop Strategy & Mandi Intelligence</div>
        </div>
      </a>

      <div class="topbar-actions">
        <button class="loc-pill" onclick="scrollToSection('citySearchCard')" title="Active Farm Location">
          <i data-lucide="map-pin"></i>
          <span id="headerLocation">UP • Prayagraj</span>
        </button>

        <div class="lang-switch" role="group" aria-label="Language switch">
          <button id="langEN" class="active" onclick="setLanguage('EN')">EN</button>
          <button id="langHI" onclick="setLanguage('HI')">हिंदी</button>
        </div>

        <button class="top-icon-btn" id="themeBtn" onclick="toggleTheme()" title="Toggle Light / Dark Theme">
          <i data-lucide="moon"></i>
        </button>

        <button class="top-icon-btn" id="notifBtn" onclick="toggleMenu('notifMenu')" title="Notifications">
          <i data-lucide="bell"></i>
          <span class="notif-dot" id="notifDot"></span>
        </button>

        <button class="profile-btn" id="profileBtn" onclick="toggleMenu('profileMenu')" title="Account & Tools">S</button>

        <!-- Notifications Popover -->
        <div class="menu-popover" id="notifMenu">
          <div class="menu-title">
            <span data-i18n="notifTitle">Live Farm Alerts</span>
            <span class="live-badge"><span class="pulse-dot"></span> Active</span>
          </div>
          <div id="notifList">
            <div class="notif-item">
              <strong>Agmarknet Telemetry Ready</strong>
              APMC wholesale price cache synchronized for 22 crops.
            </div>
            <div class="notif-item">
              <strong>Kisan Sahayak AI Online</strong>
              Ask questions in English, Hindi, or Hinglish anytime.
            </div>
          </div>
        </div>

        <!-- Profile Menu Popover -->
        <div class="menu-popover" id="profileMenu">
          <div class="menu-title">
            <span>Farmer Workspace</span>
            <span style="font-size:11px; color:var(--text-muted); font-weight:600;">Pro</span>
          </div>
          <button class="menu-item" onclick="toggleChat(true); closeMenus();">
            <i data-lucide="sparkles"></i> Open Kisan Sahayak AI
          </button>
          <button class="menu-item" onclick="window.print(); closeMenus();">
            <i data-lucide="printer"></i> Print / Save Farm Report
          </button>
          <button class="menu-item" onclick="resetToDefaults(); closeMenus();">
            <i data-lucide="rotate-ccw"></i> Reset Soil & Weather Inputs
          </button>
          <button class="menu-item" onclick="toggleTheme(); closeMenus();">
            <i data-lucide="sun-moon"></i> Switch Light / Dark Mode
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero" id="top">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <i data-lucide="sprout"></i>
          <span data-i18n="heroEyebrow">ICAR Spatio-Temporal AI &bull; Live APMC Mandi Intelligence</span>
        </div>
        <h1 data-i18n="heroHeadline">Plan Smarter. Farm Better.</h1>
        <p data-i18n="heroSubtitle">AI-driven crop strategy, precision soil insights, and live mandi revenue forecasting engineered for maximum profitability.</p>
      </div>
      <div class="hero-stats">
        <div class="hero-stat-pill">
          <div class="hero-stat-val">22 Crops</div>
          <div class="hero-stat-lbl">250-Tree AI Ensemble</div>
        </div>
        <div class="hero-stat-pill">
          <div class="hero-stat-val">14-Day</div>
          <div class="hero-stat-lbl">APMC Price Forecast</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== MAIN WORKSPACE ==================== -->
  <main class="main-wrap">

    <!-- TWO LARGE CONFIGURATION CARDS -->
    <section class="grid-2" id="configSection">

      <!-- CARD 1: SOIL CHEMICAL PROFILE -->
      <div class="card card-elevated">
        <div class="card-header">
          <div class="card-title-group">
            <div class="card-ico"><i data-lucide="flask-conical"></i></div>
            <div>
              <div class="card-title" data-i18n="soilTitle">1. Soil Chemical Profile</div>
              <div class="card-subtitle" data-i18n="soilSub">Know your soil. Grow better.</div>
            </div>
          </div>
        </div>

        <div class="tab-bar" role="tablist">
          <button class="tab-btn active" data-method="lab" onclick="setSoilMethod('lab')">
            <i data-lucide="clipboard-check"></i>
            <span data-i18n="tabLab">Lab Report</span>
          </button>
          <button class="tab-btn" data-method="regional" onclick="setSoilMethod('regional')">
            <i data-lucide="layers"></i>
            <span data-i18n="tabSoil">Soil Test</span>
          </button>
          <button class="tab-btn" data-method="visual" onclick="setSoilMethod('visual')">
            <i data-lucide="eye"></i>
            <span data-i18n="tabSymptoms">Leaf Symptoms</span>
          </button>
        </div>

        <!-- TAB 1: LAB REPORT -->
        <div id="soilPanelLab">
          <div class="status-strip green">
            <span class="status-strip-left">
              <i data-lucide="check-circle-2"></i>
              <span data-i18n="labStrip">Precision Mode — Analytical Laboratory Health Card</span>
            </span>
            <span class="conf-badge">100%</span>
          </div>

          <div class="nutrient-grid">
            <div class="nutrient-card">
              <div class="nut-head">
                <div>
                  <span class="nut-label" data-i18n="lblN">Nitrogen (N)</span>
                  <span class="nut-unit">mg/kg (ppm)</span>
                </div>
                <input type="number" class="nut-input" id="inN" min="0" max="200" step="1" value="90" />
              </div>
              <input type="range" id="rngN" min="0" max="200" step="1" value="90" />
            </div>

            <div class="nutrient-card">
              <div class="nut-head">
                <div>
                  <span class="nut-label" data-i18n="lblP">Phosphorus (P)</span>
                  <span class="nut-unit">mg/kg (ppm)</span>
                </div>
                <input type="number" class="nut-input" id="inP" min="2" max="160" step="1" value="42" />
              </div>
              <input type="range" class="saffron-range" id="rngP" min="2" max="160" step="1" value="42" />
            </div>

            <div class="nutrient-card">
              <div class="nut-head">
                <div>
                  <span class="nut-label" data-i18n="lblK">Potassium (K)</span>
                  <span class="nut-unit">mg/kg (ppm)</span>
                </div>
                <input type="number" class="nut-input" id="inK" min="2" max="220" step="1" value="43" />
              </div>
              <input type="range" id="rngK" min="2" max="220" step="1" value="43" />
            </div>

            <div class="nutrient-card">
              <div class="nut-head">
                <div>
                  <span class="nut-label" data-i18n="lblPH">Soil Reaction (pH)</span>
                  <span class="nut-unit">Scale 3.5 – 9.9</span>
                </div>
                <input type="number" class="nut-input" id="inPH" min="3.5" max="9.9" step="0.1" value="6.5" />
              </div>
              <input type="range" class="saffron-range" id="rngPH" min="3.5" max="9.9" step="0.1" value="6.5" />
            </div>
          </div>
        </div>

        <!-- TAB 2: REGIONAL SOIL TEST -->
        <div id="soilPanelRegional" style="display:none;">
          <div class="status-strip saffron">
            <span class="status-strip-left">
              <i data-lucide="globe"></i>
              <span data-i18n="regStrip">Regional Pedology Mode — Benchmark Soil Series</span>
            </span>
            <span class="conf-badge">85%</span>
          </div>
          <div class="field">
            <label for="soilTypeSelect"><i data-lucide="mountain"></i> <span data-i18n="lblSoilSelect">Select Dominant Field Soil Classification</span></label>
            <select id="soilTypeSelect"></select>
          </div>
          <div id="soilTypeInfo" class="info-box"></div>
        </div>

        <!-- TAB 3: VISUAL LEAF SYMPTOMS -->
        <div id="soilPanelVisual" style="display:none;">
          <div class="status-strip red">
            <span class="status-strip-left">
              <i data-lucide="scan-eye"></i>
              <span data-i18n="visStrip">Visual Foliar Diagnostic — Canopy Stress Mapping</span>
            </span>
            <span class="conf-badge">75%</span>
          </div>
          <div class="field">
            <label for="symptomSelect"><i data-lucide="leaf"></i> <span data-i18n="lblSymSelect">Select Visible Leaf / Plant Stress Symptom</span></label>
            <select id="symptomSelect"></select>
          </div>
          <div id="symptomInfo" class="info-box"></div>
        </div>

        <!-- Prominent Soil pH Indicator -->
        <div id="phHighlight" class="ph-highlight optimal">
          <div class="ph-meta">
            <i data-lucide="sparkles"></i>
            <div>
              <strong id="phStatusTitle">Optimal Soil Reaction (pH 6.0 – 7.5)</strong>
              <span id="phStatusDesc">Maximum availability of essential N-P-K macronutrients.</span>
            </div>
          </div>
          <div class="ph-value-pill" id="phDisplayVal">pH 6.5</div>
        </div>

        <!-- Live Soil Alerts -->
        <div id="soilAlertsBox" class="alerts-list"></div>
      </div>

      <!-- CARD 2: VIRTUAL IOT & ATMOSPHERIC SENSORS -->
      <div class="card card-elevated">
        <div class="card-header">
          <div class="card-title-group">
            <div class="card-ico"><i data-lucide="satellite-dish"></i></div>
            <div>
              <div class="card-title" data-i18n="iotTitle">2. Virtual IoT (Atmospheric Sensors)</div>
              <div class="card-subtitle" data-i18n="iotSub">Real-time climate & regional agro-climatic telemetry</div>
            </div>
          </div>
          <span class="live-badge"><span class="pulse-dot"></span> Live</span>
        </div>

        <div class="field">
          <label for="zoneSelect"><i data-lucide="map-pin"></i> <span data-i18n="lblZone">State & Agro-Climatic Zone (ICAR Classification)</span></label>
          <select id="zoneSelect"></select>
        </div>

        <div class="field">
          <label for="seasonSelect"><i data-lucide="calendar-range"></i> <span data-i18n="lblSeason">Target Sowing Season (Kharif / Rabi / Zaid)</span></label>
          <select id="seasonSelect"></select>
        </div>

        <div id="regionMetaInfo" class="info-box"></div>

        <!-- Live Weather 3 Metric Cards -->
        <div class="weather-cards">
          <div class="w-card">
            <div class="w-top">
              <span class="w-lbl" data-i18n="lblTemp">Temp</span>
              <div class="w-ico temp"><i data-lucide="thermometer"></i></div>
            </div>
            <div class="w-input-row">
              <input type="number" class="w-input" id="inTemp" min="8" max="50" step="0.1" value="26.5" />
              <span class="w-unit">°C</span>
            </div>
          </div>

          <div class="w-card">
            <div class="w-top">
              <span class="w-lbl" data-i18n="lblHum">Humidity</span>
              <div class="w-ico hum"><i data-lucide="droplets"></i></div>
            </div>
            <div class="w-input-row">
              <input type="number" class="w-input" id="inHum" min="10" max="100" step="0.1" value="68.0" />
              <span class="w-unit">%</span>
            </div>
          </div>

          <div class="w-card">
            <div class="w-top">
              <span class="w-lbl" data-i18n="lblRain">Rainfall</span>
              <div class="w-ico rain"><i data-lucide="cloud-rain"></i></div>
            </div>
            <div class="w-input-row">
              <input type="number" class="w-input" id="inRain" min="20" max="500" step="1" value="195" />
              <span class="w-unit">mm</span>
            </div>
          </div>
        </div>

        <div class="status-strip green" id="weatherInsightStrip">
          <span class="status-strip-left">
            <i data-lucide="cloud-sun"></i>
            <span id="weatherInsightText">Climate telemetry ready for real-time satellite sync.</span>
          </span>
        </div>

        <div class="iot-btn-stack">
          <button class="btn btn-forest" id="btnAutoFetch" onclick="fetchSatelliteWeather()">
            <i data-lucide="satellite"></i> <span data-i18n="btnGps">Auto-Fetch Satellite Data</span>
          </button>
          <button class="btn btn-outline" id="btnLockPrayagraj" onclick="lockPrayagraj()">
            <i data-lucide="locate-fixed"></i> <span data-i18n="btnPrayagraj">Lock Prayagraj</span>
          </button>
        </div>

        <div class="telemetry-foot">
          <span><span class="pulse-dot"></span> <span id="telemetrySource">IMD Regional Baseline</span></span>
          <span id="telemetryUpdated">Synced now</span>
        </div>
      </div>
    </section>

    <!-- DEDICATED CITY SEARCH + MASTER STRATEGY CTA -->
    <section class="action-grid">
      <div class="card" id="citySearchCard">
        <div class="card-header" style="margin-bottom:14px;">
          <div class="card-title-group">
            <div class="card-ico"><i data-lucide="navigation"></i></div>
            <div>
              <div class="card-title" data-i18n="cityTitle">Enter Your City for Localized Insights</div>
              <div class="card-subtitle" data-i18n="citySub">Override telemetry with any Indian mandal or district</div>
            </div>
          </div>
        </div>

        <div class="search-bar">
          <div class="search-input-wrap">
            <i data-lucide="search"></i>
            <input type="text" class="text-input" id="citySearchInput" placeholder="e.g. Prayagraj, Varanasi, Lucknow, Ludhiana..." />
          </div>
          <button class="btn btn-forest" id="btnCitySearch" onclick="searchCityWeather()">
            <i data-lucide="search"></i> <span data-i18n="btnSearch">Search</span>
          </button>
        </div>

        <div class="city-chips" id="citySuggestions">
          <button class="city-chip active" onclick="quickCity('Prayagraj', this)">Prayagraj</button>
          <button class="city-chip" onclick="quickCity('Varanasi', this)">Varanasi</button>
          <button class="city-chip" onclick="quickCity('Lucknow', this)">Lucknow</button>
          <button class="city-chip" onclick="quickCity('Kanpur', this)">Kanpur</button>
          <button class="city-chip" onclick="quickCity('Ludhiana', this)">Ludhiana</button>
          <button class="city-chip" onclick="quickCity('Nagpur', this)">Nagpur</button>
        </div>
      </div>

      <div class="launch-card">
        <div>
          <h3 data-i18n="launchTitle">Generate Master Strategy & Profit Forecast</h3>
          <p data-i18n="launchDesc">Runs 7-parameter soil & weather inference, ICAR regional filtering, APMC mandi pricing, and Explainable AI diagnostics.</p>
        </div>
        <button class="btn-master" id="btnGenerate" onclick="generateMasterStrategy()">
          <i data-lucide="sparkles"></i>
          <span data-i18n="btnGenerate">ANALYZE & FORECAST STRATEGY</span>
        </button>
      </div>
    </section>

    <!-- VALUE STRIP -->
    <section class="trust-strip" aria-label="Core Platform Advantages">
      <div class="trust-item"><i data-lucide="zap"></i> <span data-i18n="trust1">Faster Insights</span></div>
      <div class="trust-item"><i data-lucide="bar-chart-3"></i> <span data-i18n="trust2">Smarter Decisions</span></div>
      <div class="trust-item"><i data-lucide="indian-rupee"></i> <span data-i18n="trust3">Higher Profit</span></div>
      <div class="trust-item"><i data-lucide="sprout"></i> <span data-i18n="trust4">Sustainable Farming</span></div>
    </section>

    <!-- ==================== INTELLIGENCE OUTPUT SECTION ==================== -->
    <div class="section-divider" id="marketSection">
      <h2 data-i18n="intelHeading">Crop Recommendation & Market Intelligence</h2>
      <span id="intelSub">Live APMC Mandi &bull; Explainable AI</span>
    </div>

    <!-- POLISHED EMPTY STATE (Before First Run) -->
    <div class="empty-state" id="emptyState">
      <div class="empty-ico"><i data-lucide="sprout"></i></div>
      <h3 data-i18n="emptyTitle">Ready to Generate Your Crop Strategy</h3>
      <p data-i18n="emptyDesc">Adjust your soil chemical profile or weather telemetry above, then click <strong>Analyze & Forecast Strategy</strong> to unlock Top-3 ranked crops, APMC Mandi rates, and Explainable AI insights.</p>
      <button class="btn btn-forest" onclick="generateMasterStrategy()">
        <i data-lucide="play"></i> <span data-i18n="emptyBtn">Run Instant Analysis</span>
      </button>
    </div>

    <!-- LOADING SKELETON -->
    <div class="skeleton-wrap" id="skeletonWrap">
      <div class="skel-grid-3">
        <div class="skel-card"></div>
        <div class="skel-card"></div>
        <div class="skel-card"></div>
      </div>
      <div class="skel-grid-3">
        <div class="skel-card"></div>
        <div class="skel-card"></div>
        <div class="skel-card"></div>
      </div>
      <div class="grid-2">
        <div class="skel-card skel-tall"></div>
        <div class="skel-card skel-tall"></div>
      </div>
    </div>

    <!-- LIVE RESULTS DASHBOARD -->
    <section id="resultsSection">

      <!-- TOP 3 RECOMMENDATION CARDS -->
      <div class="rec-grid" id="recCardsGrid"></div>

      <!-- CROP IDENTITY BANNER -->
      <div class="crop-banner">
        <div class="crop-id-left">
          <div class="crop-thumb"><i data-lucide="wheat"></i></div>
          <div>
            <div class="crop-id-name" id="heroCropName">—</div>
            <div class="crop-id-meta">
              <span class="meta-tag" id="heroMatchTag"><i data-lucide="target"></i> 0% Suitability</span>
              <span class="meta-tag neutral" id="heroSeasonTag">Season</span>
              <span class="meta-tag neutral" id="heroDistrictTag">District</span>
            </div>
          </div>
        </div>

        <div class="voice-controls">
          <button class="btn btn-forest" onclick="speakCropSummary()">
            <i data-lucide="volume-2"></i> <span data-i18n="btnVoice">Voice Advisor</span>
          </button>
          <button class="btn btn-outline" onclick="stopSpeech()" title="Stop Voice">
            <i data-lucide="square"></i>
          </button>
        </div>
      </div>

      <!-- 3 FINANCIAL INTELLIGENCE CARDS -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-lbl" data-i18n="kpiLive">Current Live Mandi Price</span>
            <div class="kpi-ico"><i data-lucide="indian-rupee"></i></div>
          </div>
          <div class="kpi-val" id="kpiModalPrice">₹0</div>
          <div class="kpi-sub"><i data-lucide="trending-up"></i> APMC Modal Rate / Quintal</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-lbl" data-i18n="kpiRange">Market Price Range</span>
            <div class="kpi-ico"><i data-lucide="bar-chart-2"></i></div>
          </div>
          <div class="kpi-val" id="kpiPriceRange">₹0 – ₹0</div>
          <div class="kpi-sub"><i data-lucide="store"></i> <span id="kpiMandis">Across 16 Mandis</span></div>
        </div>

        <div class="kpi-card">
          <div class="kpi-top">
            <span class="kpi-lbl" data-i18n="kpiRevenue">Estimated Gross Revenue</span>
            <div class="kpi-ico"><i data-lucide="wallet"></i></div>
          </div>
          <div class="kpi-val" id="kpiGrossRev">₹0</div>
          <div class="kpi-sub"><i data-lucide="sprout"></i> <span id="kpiYield">Yield: 0 kg/ha</span></div>
        </div>
      </div>

      <!-- MARKET INTELLIGENCE: 7-DAY TABLE & 14-DAY CHART -->
      <div class="analytics-grid">
        <div class="card">
          <div class="card-header">
            <div class="card-title-group">
              <div class="card-ico"><i data-lucide="calendar-clock"></i></div>
              <div>
                <div class="card-title" data-i18n="histTitle">Price History (Last 7 Days)</div>
                <div class="card-subtitle" id="mandiSourceLabel">Agmarknet Official APMC Telemetry</div>
              </div>
            </div>
          </div>
          <div class="table-box">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Avg Price (₹/Q)</th>
                  <th>Arrival (Q)</th>
                </tr>
              </thead>
              <tbody id="historyTableBody"></tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title-group">
              <div class="card-ico"><i data-lucide="line-chart"></i></div>
              <div>
                <div class="card-title" data-i18n="foreTitle">14-Day Price Forecast</div>
                <div class="card-subtitle" data-i18n="foreSub">Projected wholesale mandi trajectory</div>
              </div>
            </div>
            <div class="range-pills" role="group" aria-label="Forecast range">
              <button id="rng7D" onclick="setForecastDays(7)">7D</button>
              <button id="rng14D" class="active" onclick="setForecastDays(14)">14D</button>
            </div>
          </div>

          <div class="chart-meta-row">
            <span class="sentiment-pill bullish" id="sentimentBadge">
              <i data-lucide="trending-up"></i> <span>Bullish</span>
            </span>
            <span class="peak-badge" id="peakPriceBadge">
              <i data-lucide="award"></i> Peak: ₹0
            </span>
          </div>

          <div class="chart-canvas-wrap">
            <canvas id="forecastCanvas"></canvas>
          </div>
        </div>
      </div>

      <!-- EXPLAINABLE AI MATRIX + CROP QUALITY ASSESSMENT -->
      <div class="xai-grid">
        <div class="card">
          <div class="card-header">
            <div class="card-title-group">
              <div class="card-ico"><i data-lucide="brain-circuit"></i></div>
              <div>
                <div class="card-title" data-i18n="xaiTitle">Explainable AI Matrix</div>
                <div class="card-subtitle" data-i18n="xaiSub">Understand why this crop is recommended</div>
              </div>
            </div>
          </div>

          <div id="keyFocusBanner" class="status-strip green"></div>

          <div class="table-box">
            <table>
              <thead>
                <tr>
                  <th>Status</th>
                  <th>Factor</th>
                  <th>Field</th>
                  <th>Ideal Target</th>
                  <th>Compatibility</th>
                  <th>Assessment</th>
                </tr>
              </thead>
              <tbody id="xaiTableBody"></tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <div class="card-title-group">
              <div class="card-ico"><i data-lucide="shield-check"></i></div>
              <div>
                <div class="card-title" data-i18n="qualTitle">Crop Quality Assessment AI</div>
                <div class="card-subtitle" data-i18n="qualSub">Health, grade & yield vulnerability check</div>
              </div>
            </div>
          </div>

          <div class="status-strip green" style="margin-bottom:14px;">
            <span class="status-strip-left">
              <i data-lucide="target"></i>
              <span><strong data-i18n="targetMetric">Target Metric:</strong> <span id="qualityMetricText">—</span></span>
            </span>
          </div>

          <div id="qualityVerdictBox" class="quality-banner success">
            <i data-lucide="check-circle-2"></i>
            <span id="qualityVerdictText">—</span>
          </div>

          <div class="qual-recs-title">
            <i data-lucide="lightbulb"></i>
            <span data-i18n="actionPlanTitle">Actionable Field Recommendations</span>
          </div>
          <ul class="qual-rec-list" id="qualityRecsList"></ul>
        </div>
      </div>
    </section>
  </main>

  <!-- ==================== AUTO-SMART AI BUBBLE + FLOATING LAUNCHER ==================== -->
  <div class="smart-bubble-wrap" id="smartBubble" onclick="triggerSmartBubblePrompt()">
    <div class="sb-ico" id="sbIcon"><i data-lucide="sparkles"></i></div>
    <div class="sb-body">
      <div class="sb-eyebrow" id="sbTitle">Smart Farm Assistant</div>
      <div class="sb-text" id="sbText">Need help entering soil NPK or checking mandi rates?</div>
      <span class="sb-cta">Ask Kisan Sahayak <i data-lucide="arrow-right"></i></span>
    </div>
    <button class="sb-close" onclick="dismissSmartBubble(event)" aria-label="Dismiss tip">
      <i data-lucide="x"></i>
    </button>
  </div>

  <button class="chat-fab" id="chatFab" onclick="toggleChat()">
    <i data-lucide="sprout"></i>
    <span>Kisan Sahayak AI</span>
    <span class="fab-badge" id="fabBadge">1 Tip</span>
    <span class="pulse-dot"></span>
  </button>

  <aside class="chat-drawer" id="chatDrawer" aria-label="Kisan Sahayak AI Assistant">
    <div class="chat-head">
      <div class="chat-head-left">
        <div class="chat-av"><i data-lucide="sprout"></i></div>
        <div>
          <div class="chat-h-name">Kisan Sahayak AI</div>
          <div class="chat-h-sub"><span class="pulse-dot"></span> Live Screen Aware &bull; EN / हिंदी / Hinglish</div>
        </div>
      </div>
      <div class="chat-h-btns">
        <button class="chat-h-btn" onclick="clearChat()" title="Clear chat"><i data-lucide="trash-2"></i></button>
        <button class="chat-h-btn" onclick="toggleChat(false)" title="Close"><i data-lucide="x"></i></button>
      </div>
    </div>

    <div class="chat-chips" id="chatQuickChips">
      <button class="chat-chip" onclick="sendQuickPrompt('Mere screen par jo crop result, mandi bhav, aur warnings aaye hain unhe simple Hinglish mein samjhao.')">
        <i data-lucide="bar-chart-3"></i> Result
      </button>
      <button class="chat-chip" onclick="sendQuickPrompt('Maine abhi tak website par kya kiya hai aur mujhe aage kya karna chahiye?')">
        <i data-lucide="compass"></i> Next Step
      </button>
      <button class="chat-chip" onclick="sendQuickPrompt('Mere recommended crop ka Mandi bhav, 14-day forecast aur profit potential Hinglish mein samjhao.')">
        <i data-lucide="indian-rupee"></i> Mandi
      </button>
    </div>

    <div class="chat-body" id="chatFeed"></div>

    <div class="chat-voice">
      <div style="display:flex; gap:6px;">
        <button class="v-pill play" onclick="speakLatestChat()"><i data-lucide="volume-2"></i> Suniye</button>
        <button class="v-pill" onclick="stopSpeech()"><i data-lucide="square"></i> Stop</button>
      </div>
      <select class="v-lang" id="chatVoiceLang">
        <option value="en-IN">EN / Hinglish</option>
        <option value="hi-IN">हिंदी (HI)</option>
      </select>
    </div>

    <form class="chat-form" onsubmit="handleChatSubmit(event)">
      <input type="text" class="text-input" id="chatInput" placeholder="Ask in English, हिंदी, or Hinglish..." autocomplete="off" />
      <button type="submit" class="send-btn" id="chatSendBtn" aria-label="Send message">
        <i data-lucide="send"></i>
      </button>
    </form>
  </aside>

  <!-- ==================== MOBILE BOTTOM NAVIGATION ==================== -->
  <nav class="mobile-nav" aria-label="Mobile Navigation">
    <button class="m-nav-btn active" id="mNavHome" onclick="mobileNav('home')">
      <i data-lucide="home"></i><span>Home</span>
    </button>
    <button class="m-nav-btn" id="mNavMarket" onclick="mobileNav('market')">
      <i data-lucide="bar-chart-2"></i><span>Market</span>
    </button>
    <button class="m-nav-btn m-nav-center" onclick="mobileNav('analyze')">
      <span class="m-nav-fab"><i data-lucide="sparkles"></i></span>
      <span>Analyze</span>
    </button>
    <button class="m-nav-btn" id="mNavAdvisor" onclick="mobileNav('advisor')">
      <span class="m-advisor-dot" id="mAdvisorDot"></span><i data-lucide="message-circle"></i><span>Advisor</span>
    </button>
    <button class="m-nav-btn" id="mNavMore" onclick="mobileNav('more')">
      <i data-lucide="more-horizontal"></i><span>More</span>
    </button>
  </nav>

  <!-- ==================== APPLICATION SCRIPT ==================== -->
  <script>
    const I18N = {
      EN: {
        brandName: "Agri-Predictor Pro",
        brandTag: "AI-Powered Crop Strategy & Mandi Intelligence",
        heroEyebrow: "ICAR Spatio-Temporal AI • Live APMC Mandi Intelligence",
        heroHeadline: "Plan Smarter. Farm Better.",
        heroSubtitle: "AI-driven crop strategy, precision soil insights, and live mandi revenue forecasting engineered for maximum profitability.",
        soilTitle: "1. Soil Chemical Profile",
