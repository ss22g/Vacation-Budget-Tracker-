    function trHi(text) {
      if (state.lang !== "HI" || !text) return String(text ?? "");
      let s = String(text);
      for (const [cityEn, cityHi] of Object.entries(HI_CITIES)) {
        s = s.replace(new RegExp(`\\b${cityEn}\\b`, "g"), cityHi);
      }
      for (const [en, hi] of HI_PHRASE_MAP) {
        if (s.includes(en)) s = s.split(en).join(hi);
      }
      return s;
    }

    function trCrop(name) {
      if (state.lang !== "HI" || !name) return String(name ?? "");
      return HI_CROPS[String(name).toLowerCase().trim()] || name;
    }

    function trFactor(factor) {
      if (state.lang !== "HI" || !factor) return String(factor ?? "");
      return HI_FACTORS[String(factor).toLowerCase().trim()] || factor;
    }

    function trAssessment(assess) {
      if (state.lang !== "HI") return String(assess ?? "");
      const a = String(assess || "");
      if (a.includes("PERFECT")) return "बिल्कुल उपयुक्त";
      if (a.includes("HIGH")) return "अधिक (सहनशील)";
      if (a.includes("LOW")) return "कम (सुधार ज़रूरी)";
      return a;
    }

    function trDate(dateStr) {
      if (state.lang !== "HI" || !dateStr) return String(dateStr ?? "");
      return String(dateStr).replace(/\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\b/g, (m) => HI_MONTHS[m] || m);
    }

    function translateSelectOptions() {
      ["zoneSelect", "seasonSelect", "soilTypeSelect", "symptomSelect"].forEach((id) => {
        const sel = document.getElementById(id);
        if (!sel) return;
        for (const opt of sel.options) {
          opt.textContent = state.lang === "HI" ? trHi(opt.value) : opt.value;
        }
      });
    }

    function translateCityChipsAndPlaceholders() {
      const dict = I18N[state.lang];
      const cityIn = document.getElementById("citySearchInput");
      if (cityIn && dict.cityPlaceholder) cityIn.placeholder = dict.cityPlaceholder;
      const chatIn = document.getElementById("chatInput");
      if (chatIn && dict.chatPlaceholder) chatIn.placeholder = dict.chatPlaceholder;

      document.querySelectorAll(".city-chip[data-city]").forEach((btn) => {
        const orig = btn.getAttribute("data-city");
        btn.textContent = state.lang === "HI" ? (HI_CITIES[orig] || orig) : orig;
      });
    }

    // Override core dynamic renderers so Hindi mode converts everything except numbers & key terms
    updatePhBanner = function() {
      const { ph } = getCurrentSoilValues();
      const box = document.getElementById("phHighlight");
      const title = document.getElementById("phStatusTitle");
      const desc = document.getElementById("phStatusDesc");
      const isHi = state.lang === "HI";
      document.getElementById("phDisplayVal").textContent = `pH ${Number(ph).toFixed(1)}`;

      if (ph >= 6.0 && ph <= 7.5) {
        box.className = "ph-highlight optimal";
        title.textContent = isHi ? "संतुलित मिट्टी pH (6.0 – 7.5)" : "Optimal Soil Reaction (pH 6.0 – 7.5)";
        desc.textContent = isHi ? "N-P-K आवश्यक पोषक तत्वों की अधिकतम उपलब्धता।" : "Maximum availability of essential N-P-K macronutrients.";
      } else if (ph < 6.0) {
        box.className = "ph-highlight";
        title.textContent = isHi ? "अम्लीय मिट्टी (pH < 6.0)" : "Acidic Soil Reaction (pH < 6.0)";
        desc.textContent = isHi ? "अम्लीयता संतुलित करने के लिए कृषि चूना (CaCO₃) मिलाएँ।" : "Consider agricultural lime (CaCO₃) to balance soil acidity.";
      } else {
        box.className = "ph-highlight";
        title.textContent = isHi ? "क्षारीय मिट्टी (pH > 7.5)" : "Alkaline Soil Reaction (pH > 7.5)";
        desc.textContent = isHi ? "पोषक तत्व बढ़ाने के लिए जिप्सम और जैविक खाद का उपयोग करें।" : "Consider gypsum and organic compost to improve nutrient uptake.";
      }
      if (state.bootstrap) updateSmartBubble("soil");
    };

    updateSoilTypeInfo = function() {
      if (!state.bootstrap) return;
      const key = document.getElementById("soilTypeSelect").value;
      const d = state.bootstrap.soil_archetypes[key];
      const isHi = state.lang === "HI";
      document.getElementById("soilTypeInfo").innerHTML = `
        <div><strong>${isHi ? "बनावट:" : "Texture:"}</strong> ${escapeHtml(trHi(d.texture))} &nbsp;&bull;&nbsp; <strong>${isHi ? "जैविक कार्बन:" : "Organic Carbon:"}</strong> ${escapeHtml(trHi(d.organic_carbon))}</div>
        <div><strong>${isHi ? "जल निकासी:" : "Drainage:"}</strong> ${escapeHtml(trHi(d.permeability))}</div>
        <div><strong>${isHi ? "खेत टिप्पणी:" : "Field Note:"}</strong> ${escapeHtml(trHi(d.limiting_note))}</div>
        <div class="chip-row">
          <span class="mini-chip">N: ${d.N}</span>
          <span class="mini-chip">P: ${d.P}</span>
          <span class="mini-chip">K: ${d.K}</span>
          <span class="mini-chip">pH: ${d.pH}</span>
        </div>`;
      logStep("Selected Soil Type", key);
      updatePhBanner();
      refreshSoilAlerts();
    };

    updateSymptomInfo = function() {
      if (!state.bootstrap) return;
      const key = document.getElementById("symptomSelect").value;
      const d = state.bootstrap.visual_symptoms[key];
      const isHi = state.lang === "HI";
      document.getElementById("symptomInfo").innerHTML = `
        <div><strong>${isHi ? "अनुमानित निदान:" : "Inferred Diagnosis:"}</strong> ${escapeHtml(trHi(d.diagnosis))}</div>
        <div><strong>${isHi ? "सुधारात्मक उपाय:" : "Corrective Action:"}</strong> ${escapeHtml(trHi(d.recommendation))}</div>
        <div class="chip-row">
          <span class="mini-chip">N: ${d.N}</span>
          <span class="mini-chip">P: ${d.P}</span>
          <span class="mini-chip">K: ${d.K}</span>
          <span class="mini-chip">pH: ${d.pH}</span>
        </div>`;
      logStep("Selected Leaf Symptom", key);
      updatePhBanner();
      refreshSoilAlerts();
    };

    refreshSoilAlerts = function() {
      clearTimeout(soilAlertTimer);
      soilAlertTimer = setTimeout(async () => {
        try {
          const res = await fetch("/api/soil-alerts", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(getCurrentSoilValues()),
          });
          const data = await res.json();
          state.soilAlerts = data.alerts || [];
          document.getElementById("soilAlertsBox").innerHTML = state.soilAlerts
            .map((a) => `<div class="alert-row">${formatMd(state.lang === "HI" ? trHi(a) : a)}</div>`)
            .join("");
        } catch (e) {}
      }, 150);
    };

    updateHeaderLoc = function(cityLabel) {
      const zoneKey = document.getElementById("zoneSelect").value;
      const r = state.bootstrap?.regions[zoneKey];
      const stName = r?.state || "India";
      const place = cityLabel || r?.station || "Prayagraj";
      document.getElementById("headerLocation").textContent =
        state.lang === "HI" ? `${trHi(stName)} • ${trHi(place)}` : `${stName} • ${place}`;
    };

    updateWeatherInsight = function() {
      const t = parseFloat(document.getElementById("inTemp").value) || 26;
      const h = parseFloat(document.getElementById("inHum").value) || 68;
      const el = document.getElementById("weatherInsightText");
      const isHi = state.lang === "HI";
      if (t >= 18 && t <= 32 && h >= 45 && h <= 85) {
        el.textContent = isHi
          ? "मौसम बुवाई और स्वस्थ अंकुरण के लिए बिल्कुल अनुकूल है।"
          : "Weather window is well balanced for seasonal sowing & healthy germination.";
      } else if (h < 40) {
        el.textContent = isHi
          ? "हवा में नमी कम है — हल्की सिंचाई और मल्चिंग की योजना बनाएं।"
          : "Low atmospheric humidity detected — plan drip/furrow irrigation & mulching.";
      } else if (t > 35) {
        el.textContent = isHi
          ? "तापमान अधिक है — गर्मी सहनशील फसलें और नमी संरक्षण चुनें।"
          : "High daytime temperature — prioritize heat-tolerant crops and moisture retention.";
      } else {
        el.textContent = isHi
          ? "मौसम डेटा तैयार है — फसल उपयुक्तता विश्लेषण शुरू करें।"
          : "Climate telemetry calibrated — ready for crop suitability analysis.";
      }
    };

    updateRegionMeta = function(syncBaselines = true) {
      if (!state.bootstrap) return;
      const zoneKey = document.getElementById("zoneSelect").value;
      const seasonKey = document.getElementById("seasonSelect").value;
      const r = state.bootstrap.regions[zoneKey];
      const s = state.bootstrap.seasons[seasonKey];
      const isHi = state.lang === "HI";

      document.getElementById("regionMetaInfo").innerHTML = `
        <div><strong>${isHi ? "ICAR क्षेत्र:" : "ICAR Zone:"}</strong> ${escapeHtml(trHi(r.zone))} &nbsp;&bull;&nbsp; <strong>${isHi ? "क्षेत्रीय मिट्टी:" : "Regional Soil:"}</strong> ${escapeHtml(trHi(r.soil))}</div>
        <div><strong>${isHi ? "बुवाई फ़िल्टर:" : "Season Filter:"}</strong> ${escapeHtml(trHi(s.description))}</div>`;

      updateHeaderLoc(r.station);

      if (syncBaselines) {
        document.getElementById("inTemp").value = r.base_temp;
        document.getElementById("inHum").value = r.base_hum;
        document.getElementById("inRain").value = r.base_rain;
        document.getElementById("telemetrySource").textContent = isHi
          ? `IMD क्षेत्रीय मानक (${trHi(r.station)})`
          : `IMD Regional Baseline (${r.station})`;
        document.getElementById("telemetryUpdated").textContent = isHi
          ? `अपडेट ${nowClock()}`
          : `Updated ${nowClock()}`;
        syncLabInputs(r.def_N, r.def_P, r.def_K, r.def_pH);
        updateWeatherInsight();
        refreshSoilAlerts();
      }
    };

    renderRecCards = function() {
      const grid = document.getElementById("recCardsGrid");
      const rankNames = I18N[state.lang].rankNames;
      const icons = ["sprout", "leaf", "wheat"];
      grid.innerHTML = state.prediction.strategies
        .map(
          (s, idx) => `
          <button class="rec-card ${idx === state.activeRankIdx ? "active" : ""}" onclick="selectStrategy(${idx})">
            <div class="rec-left">
              <div class="rec-ico"><i data-lucide="${icons[idx]}"></i></div>
              <div>
                <div class="rec-rank">${rankNames[idx]}</div>
                <div class="rec-crop">${escapeHtml(trCrop(s.crop))}</div>
              </div>
            </div>
            <div class="rec-score">${s.match_percent}%</div>
          </button>`
        )
        .join("");
      refreshIcons();
    };

    buildDynamicRecommendations = function(strategy) {
      const recs = [];
      const isHi = state.lang === "HI";
      const lowRows = strategy.xai.filter((r) => r.status === "low");
      const highRows = strategy.xai.filter((r) => r.status === "warn");

      for (const row of lowRows) {
        const f = row.factor.toLowerCase();
        if (isHi) {
          if (f === "n") recs.push(`नाइट्रोजन (${row.field_value}) आदर्श (${row.ideal_target}) से कम है — वानस्पतिक बढ़वार से पहले यूरिया या वर्मीकम्पोस्ट की संतुलित मात्रा दें।`);
          else if (f === "p") recs.push(`फास्फोरस (${row.field_value}) कम है — मजबूत जड़ों के लिए बुवाई के समय DAP या सिंगल सुपर फॉस्फेट डालें।`);
          else if (f === "k") recs.push(`पोटेशियम (${row.field_value}) की कमी है — दाने भरने व रोग प्रतिरोधकता के लिए पोटाश (MOP) दें।`);
          else if (f === "humidity" || f === "rainfall") recs.push(`${trFactor(row.factor)} (${row.field_value}) कम है — नमी बचाने के लिए हल्की सिंचाई और जैविक मल्चिंग करें।`);
          else recs.push(`उपज सुरक्षित रखने के लिए ${trFactor(row.factor)} (${row.field_value} बनाम लक्ष्य ${row.ideal_target}) को संतुलित करें।`);
        } else {
          if (f === "n") recs.push(`Nitrogen (${row.field_value}) is below ideal (${row.ideal_target}) — split-apply Urea or vermicompost before vegetative growth.`);
          else if (f === "p") recs.push(`Phosphorus (${row.field_value}) is low — apply basal DAP or Single Super Phosphate at sowing for root strength.`);
          else if (f === "k") recs.push(`Potassium (${row.field_value}) is deficient — supplement Muriate of Potash (MOP) to boost grain filling & disease resistance.`);
          else if (f === "humidity" || f === "rainfall") recs.push(`${row.factor} (${row.field_value}) is below target — schedule light irrigation and apply organic mulching to preserve soil moisture.`);
          else recs.push(`Supplement or stabilize ${row.factor} (current ${row.field_value} vs target ${row.ideal_target}) to protect yield potential.`);
        }
      }

      if (highRows.length) {
        const names = highRows.map((r) => trFactor(r.factor)).join(", ");
        recs.push(
          isHi
            ? `खाद का खर्च बचाएँ: ${names} पहले से पर्याप्त (${trAssessment(highRows[0].assessment)}) है — अतिरिक्त खाद न डालें।`
            : `Save input costs: ${names} ${highRows.length > 1 ? "are" : "is"} already above ideal (${highRows[0].assessment}) — avoid extra application.`
        );
      }

      const isBullish = strategy.mandi.sentiment.toLowerCase().includes("bullish");
      const endPrice = fmtINR(strategy.mandi.forecast[strategy.mandi.forecast.length - 1].price);
      recs.push(
        isHi
          ? (isBullish
              ? `मंडी रुझान तेज़ी की ओर (${endPrice}/क्विंटल) है — चरणबद्ध बिक्री या सुरक्षित भंडारण से बेहतर लाभ मिल सकता है।`
              : `बाजार में आवक अधिक है — स्थानीय APMC भाव पर नज़र रखें या समय पर MSP बिक्री चुनें।`)
          : (isBullish
              ? `Market trend is Bullish toward ${endPrice}/Q — staggered selling or short-term dry storage may improve margins.`
              : `Market supply is currently high — monitor local APMC arrivals closely or lock MSP procurement early.`)
      );

      return recs.slice(0, 4);
    };

    renderActiveStrategy = function() {
      const s = state.prediction.strategies[state.activeRankIdx];
      const m = s.mandi;
      const isHi = state.lang === "HI";
      const cropLabel = trCrop(s.crop);
      const focusFactor = trFactor(s.key_focus_factor);
      const focusAssess = trAssessment(s.key_focus_assessment);

      document.getElementById("heroCropName").textContent = cropLabel;
      document.getElementById("heroMatchTag").innerHTML = `<i data-lucide="target"></i> ${s.match_percent}% ${isHi ? "जैविक अनुकूलता" : "Biological Match"}`;
      document.getElementById("heroSeasonTag").textContent = trHi(s.season_badge);
      document.getElementById("heroDistrictTag").textContent = `${trHi(state.prediction.district)}, ${trHi(state.prediction.state)}`;

      document.getElementById("kpiModalPrice").textContent = fmtINR(m.current_price);
      document.getElementById("kpiPriceRange").textContent = `${fmtINR(m.min_price)} – ${fmtINR(m.max_price)}`;
      document.getElementById("kpiMandis").textContent = isHi
        ? `${m.mandis_count} मंडियों का औसत`
        : `Across ${m.mandis_count} Mandis`;
      document.getElementById("kpiGrossRev").textContent = fmtINR(m.est_revenue);
      document.getElementById("kpiYield").textContent = isHi
        ? `अनुमानित उपज: ${Number(m.expected_yield_kg).toLocaleString("en-IN")} किग्रा/हेक्टेयर`
        : `Yield: ${Number(m.expected_yield_kg).toLocaleString("en-IN")} kg/ha`;

      document.getElementById("mandiSourceLabel").textContent = trHi(m.source_label);
      document.getElementById("historyTableBody").innerHTML = m.history
        .map(
          (row) => `
          <tr>
            <td>${escapeHtml(trDate(row.date))}</td>
            <td>${fmtINR(row.price)}</td>
            <td>${Number(row.arrival).toLocaleString("en-IN")}</td>
          </tr>`
        )
        .join("");

      const isBullish = m.sentiment.toLowerCase().includes("bullish");
      const sb = document.getElementById("sentimentBadge");
      sb.className = `sentiment-pill ${isBullish ? "bullish" : "bearish"}`;
      const sentText = isHi
        ? (isBullish ? "तेज़ी का रुख (बढ़ती मांग)" : "मंदी का रुख (अधिक आवक)")
        : m.sentiment;
      sb.innerHTML = `<i data-lucide="${isBullish ? "trending-up" : "trending-down"}"></i> <span>${escapeHtml(sentText)}</span>`;

      renderForecastChart(m.forecast.slice(0, state.forecastDays));

      const kf = document.getElementById("keyFocusBanner");
      if (s.key_focus_assessment.includes("LOW")) {
        kf.className = "status-strip red";
        kf.innerHTML = `<span class="status-strip-left"><i data-lucide="alert-triangle"></i><span><strong>${isHi ? "मुख्य ध्यान कारक:" : "Key Focus Factor:"}</strong> ${isHi ? `${escapeHtml(focusFactor)} आदर्श स्तर से कम है (${escapeHtml(focusAssess)})। तुरंत सुधार की सलाह है।` : `${escapeHtml(s.key_focus_factor)} is below optimal range (${escapeHtml(s.key_focus_assessment)}). Supplementation advised.`}</span></span>`;
      } else if (s.key_focus_assessment.includes("HIGH")) {
        kf.className = "status-strip saffron";
        kf.innerHTML = `<span class="status-strip-left"><i data-lucide="info"></i><span><strong>${isHi ? "विशेष टिप्पणी:" : "Parameter Note:"}</strong> ${isHi ? `${escapeHtml(focusFactor)} औसत से अधिक है (${escapeHtml(focusAssess)}), जो फसल के लिए सहनशील सीमा में है।` : `${escapeHtml(s.key_focus_factor)} is above average (${escapeHtml(s.key_focus_assessment)}), within tolerable bounds.`}</span></span>`;
      } else {
        kf.className = "status-strip green";
        kf.innerHTML = `<span class="status-strip-left"><i data-lucide="check-circle-2"></i><span><strong>${isHi ? "पोषक संतुलन:" : "Nutrient Synergy:"}</strong> ${isHi ? `आपकी मिट्टी और मौसम ${escapeHtml(cropLabel)} के लिए उत्तम मेल खाते हैं।` : `Soil and climate profiles align closely with ${escapeHtml(s.crop)}.`}</span></span>`;
      }

      document.getElementById("xaiTableBody").innerHTML = s.xai
        .map(
          (row) => `
          <tr>
            <td><span class="status-dot ${row.status}"></span></td>
            <td>${escapeHtml(trFactor(row.factor))}</td>
            <td>${row.field_value}</td>
            <td>${escapeHtml(row.ideal_target)}</td>
            <td>
              <div class="bar-cell">
                <div class="bar-track"><div class="bar-fill ${row.status}" style="width:${row.fit}%"></div></div>
                <span class="bar-num">${row.fit}%</span>
              </div>
            </td>
            <td><span class="badge ${row.status}">${escapeHtml(trAssessment(row.assessment))}</span></td>
          </tr>`
        )
        .join("");

      document.getElementById("qualityMetricText").textContent = trHi(s.quality.metric);
      const qBox = document.getElementById("qualityVerdictBox");
      const qIco = s.quality.level === "danger" ? "alert-triangle" : s.quality.level === "warning" ? "alert-circle" : "check-circle-2";
      qBox.className = `quality-banner ${s.quality.level}`;
      let verdictText = s.quality.verdict;
      if (isHi) {
        if (s.quality.level === "danger") {
          verdictText = `जोखिम चेतावनी: ${focusFactor} आदर्श सीमा से कम है। उपज व गुणवत्ता बचाने के लिए तुरंत ${focusFactor} का सुधार करें।`;
        } else if (s.quality.level === "warning") {
          verdictText = `मध्यम निगरानी: ${focusFactor} औसत से अधिक है। फसल के दौरान ${focusFactor} के स्तर पर नियमित निगरानी रखें।`;
        } else {
          verdictText = `उत्तम ग्रेड संभावित: ${focusFactor} सहित सभी मिट्टी व मौसम कारक पूरी तरह संतुलित हैं।`;
        }
      }
      qBox.innerHTML = `<i data-lucide="${qIco}"></i><span>${escapeHtml(verdictText)}</span>`;

      const recs = buildDynamicRecommendations(s);
      document.getElementById("qualityRecsList").innerHTML = recs
        .map((r) => `<li><i data-lucide="check"></i><span>${escapeHtml(r)}</span></li>`)
        .join("");

      syncVoiceUI();
      refreshIcons();
    };

    const _origRenderChart = renderForecastChart;
    renderForecastChart = function(points) {
      const localizedPoints = state.lang === "HI"
        ? points.map((p) => ({ ...p, date: trDate(p.date) }))
        : points;
      _origRenderChart(localizedPoints);
      const peak = Math.max(...points.map((p) => p.price));
      document.getElementById("peakPriceBadge").innerHTML =
        `<i data-lucide="award"></i> ${state.lang === "HI" ? "अधिकतम:" : "Peak:"} ${fmtINR(peak)}/${state.lang === "HI" ? "क्विं." : "Q"}`;
      refreshIcons();
    };

    renderDynamicQuickChips = function() {
      const bar = document.getElementById("chatQuickChips");
      if (!bar) return;
      const isHi = state.lang === "HI";
      let chips;
      if (state.prediction) {
        const s = state.prediction.strategies[state.activeRankIdx];
        const cName = isHi ? trCrop(s.crop).split(" (")[0] : s.crop;
        chips = [
          {
            icon: "bar-chart-3",
            label: isHi ? `${cName} समझें` : `Explain ${s.crop}`,
            prompt: isHi
              ? `मेरी सुझाई गई फसल ${s.crop} (${s.match_percent}%) का परिणाम, XAI चेतावनी और खेती के कदम सरल हिंदी में समझाइए।`
              : `Mere recommended crop ${s.crop} (${s.match_percent}%) ka result, XAI warnings aur field steps simple Hinglish mein samjhao.`,
          },
          {
            icon: "wrench",
            label: isHi ? `${trFactor(s.key_focus_factor).split(" (")[0]} सुधारें` : `Fix ${s.key_focus_factor}`,
            prompt: isHi
              ? `${s.crop} के लिए मेरा ${s.key_focus_factor} (${s.key_focus_assessment}) कैसे ठीक करूँ? सस्ते और व्यावहारिक उपाय बताइए।`
              : `${s.crop} ke liye mera ${s.key_focus_factor} (${s.key_focus_assessment}) kaise theek karun? Practical desi upay batao.`,
          },
          {
            icon: "indian-rupee",
            label: isHi ? "मंडी मुनाफा" : "Mandi Profit",
            prompt: isHi
              ? `${s.crop} का वर्तमान मंडी भाव, 14-दिन का पूर्वानुमान और बिक्री की सबसे अच्छी रणनीति हिंदी में बताइए।`
              : `${s.crop} ka current Mandi bhav, 14-day forecast aur best selling strategy Hinglish mein batao.`,
          },
        ];
      } else {
        const { ph } = getCurrentSoilValues();
        chips = [
          {
            icon: "flask-conical",
            label: isHi ? "मिट्टी सहायता" : "Soil Help",
            prompt: isHi
              ? `मेरी मिट्टी के वर्तमान मान (pH ${Number(ph).toFixed(1)}) का क्या अर्थ है? क्या कोई सुधार ज़रूरी है?`
              : `Mere current soil values (pH ${Number(ph).toFixed(1)}) ka kya matlab hai? Kya koi sudhar zaroori hai?`,
          },
          {
            icon: "compass",
            label: isHi ? "अगला कदम" : "Next Step",
            prompt: isHi
              ? "मैंने अभी तक वेबसाइट पर क्या किया है और मुझे आगे क्या करना चाहिए?"
              : "Maine abhi tak website par kya kiya hai aur mujhe aage kya karna chahiye?",
          },
          {
            icon: "sprout",
            label: isHi ? "सर्वोत्तम ऋतु" : "Best Season",
            prompt: isHi
              ? "मेरे चुने गए ICAR क्षेत्र और मौसम के अनुसार कौन-सी फसलें सबसे अधिक मुनाफा देती हैं?"
              : "Mere selected ICAR zone aur season ke hisaab se kaunsi faslein sabse zyada profitable hoti hain?",
          },
        ];
      }
      bar.innerHTML = chips
        .map((c, i) => `<button type="button" class="chat-chip" data-chip-idx="${i}"><i data-lucide="${c.icon}"></i> ${escapeHtml(c.label)}</button>`)
        .join("");
      bar.querySelectorAll(".chat-chip").forEach((btn, i) => {
        btn.addEventListener("click", () => sendQuickPrompt(chips[i].prompt));
      });
      refreshIcons();
    };

    const _origRenderFeedForLang = renderChatFeed;
    renderChatFeed = function(showTyping = false) {
      _origRenderFeedForLang(showTyping);
      if (state.lang === "HI") {
        document.querySelectorAll(".c-tool-btn").forEach((b) => {
          if (b.textContent.includes("Listen")) b.innerHTML = '<i data-lucide="volume-2"></i> सुनें';
          else if (b.textContent.includes("Copy")) b.innerHTML = '<i data-lucide="copy"></i> कॉपी';
        });
        refreshIcons();
      }
    };

    const _origUpdateSmartBubbleLang = updateSmartBubble;
    updateSmartBubble = function(trigger = "auto") {
      if (state.lang !== "HI") {
        _origUpdateSmartBubbleLang(trigger);
        return;
      }
      renderDynamicQuickChips();
      if (state.prediction && (trigger === "prediction" || trigger === "tab" || trigger === "auto")) {
        const s = state.prediction.strategies[state.activeRankIdx];
        const cName = trCrop(s.crop).split(" (")[0];
        const lowRow = s.xai.find((r) => r.status === "low");
        if (lowRow) {
          showSmartBubble({
            key: `pred-low-${s.crop}-${lowRow.factor}`,
            level: "danger",
            icon: "alert-triangle",
            title: `सुधार अलर्ट • ${cName}`,
            text: `${trFactor(lowRow.factor)} कम (${lowRow.field_value}) है। आसान उपाय जानने के लिए टैप करें!`,
            badge: "सुधार अलर्ट",
            prompt: `${s.crop} में मेरा ${lowRow.factor} (${lowRow.field_value}) कम दिख रहा है। इसे ठीक करने के सस्ते उपाय हिंदी में बताइए।`,
            forceShow: trigger === "prediction" || trigger === "tab",
          });
          return;
        }
        showSmartBubble({
          key: `pred-ok-${s.crop}`,
          level: "",
          icon: "trending-up",
          title: `${cName} (${s.match_percent}%) तैयार`,
          text: `लाइव मंडी ₹${Math.round(s.mandi.current_price)}/क्विं.। मुनाफा योजना जानने के लिए टैप करें!`,
          badge: "मुनाफा टिप",
          prompt: `मेरी फसल ${s.crop} का मंडी भाव, 14-दिन का रुझान और मुनाफा रणनीति हिंदी में समझाइए।`,
          forceShow: trigger === "prediction" || trigger === "tab",
        });
        return;
      }
      if (trigger === "weather") {
        const t = document.getElementById("inTemp").value;
        const h = document.getElementById("inHum").value;
        showSmartBubble({
          key: `weather-${t}-${h}`,
          level: "",
          icon: "satellite",
          title: "मौसम डेटा सिंक हुआ",
          text: `${t}°C तापमान व ${h}% नमी प्राप्त। इस मौसम की सही फसलें जानें!`,
          badge: "मौसम",
          prompt: `अभी स्क्रीन पर ${t}°C तापमान और ${h}% नमी है। इस मौसम में कौन-सी फसलें सबसे अच्छी रहेंगी?`,
          forceShow: true,
        });
        return;
      }
      const { ph } = getCurrentSoilValues();
      if (ph < 6.0 || ph > 7.5) {
        const kind = ph < 6.0 ? "अम्लीय" : "क्षारीय";
        showSmartBubble({
          key: `ph-${kind}`,
          level: "warn",
          icon: "flask-conical",
          title: `${kind} मिट्टी (pH ${Number(ph).toFixed(1)})`,
          text: "मिट्टी का pH 6.0–7.5 के बाहर है। संतुलन उपाय के लिए टैप करें!",
          badge: "pH अलर्ट",
          prompt: `मेरी मिट्टी का pH ${Number(ph).toFixed(1)} (${kind}) है। इसे संतुलित करने का सरल उपाय हिंदी में बताइए।`,
          forceShow: trigger === "soil",
        });
        return;
      }
      if (trigger === "init") {
        showSmartBubble({
          key: "welcome-smart-hi",
          level: "",
          icon: "sparkles",
          title: "किसान सहायक AI तैयार",
          text: "मिट्टी रिपोर्ट भरने या लाइव मंडी भाव जानने में मदद चाहिए? टैप करें!",
          badge: "AI तैयार",
          prompt: "नमस्ते! मुझे Agri-Predictor Pro का उपयोग कैसे करना है और अपनी मिट्टी के लिए सही फसल कैसे चुनूं?",
          forceShow: true,
        });
      }
    };

    // Full setLanguage override: updates HTML lang, Devanagari font stack, static text, dropdowns & all live panels
    setLanguage = function(lang) {
      state.lang = lang === "HI" ? "HI" : "EN";
      localStorage.setItem("agri_lang_v2", state.lang);
      document.documentElement.setAttribute("lang", state.lang === "HI" ? "hi" : "en");
      document.documentElement.setAttribute("data-lang", state.lang === "HI" ? "hi" : "en");

      document.getElementById("langEN").classList.toggle("active", state.lang === "EN");
      document.getElementById("langHI").classList.toggle("active", state.lang === "HI");

      const dict = I18N[state.lang];
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n");
        if (dict[key]) el.textContent = dict[key];
      });

      translateSelectOptions();
      translateCityChipsAndPlaceholders();
      updatePhBanner();
      updateWeatherInsight();
      if (state.bootstrap) {
        updateRegionMeta(false);
        updateSoilTypeInfo();
        updateSymptomInfo();
        refreshSoilAlerts();
      }
      if (state.prediction) {
        renderRecCards();
        renderActiveStrategy();
      }
      renderDynamicQuickChips();
      renderChatFeed(false);
      syncVoiceUI();
      updateSmartBubble("auto");
      logStep("Selected UI Language", state.lang);
    };

    // Restore saved language automatically on page load
    const _origInitForLang = initApp;
    initApp = async function() {
      await _origInitForLang();
      const savedLang = localStorage.getItem("agri_lang_v2");
      if (savedLang === "HI") {
        setLanguage("HI");
      } else {
        translateCityChipsAndPlaceholders();
      }
    };


    /* ---------------- SHERYIANS EDITORIAL ACCENT HOOK ---------------- */
    function applyEditorialHeroAccent() {
      const h1 = document.querySelector('[data-i18n="heroHeadline"]');
      if (!h1) return;
      if (state.lang === "EN") {
        h1.innerHTML = 'Plan <em class="serif-accent">Smarter.</em> Farm <em class="serif-accent">Better.</em>';
      } else {
        h1.textContent = I18N.HI.heroHeadline;
      }
    }

    const _origSetLangEditorial = setLanguage;
    setLanguage = function(lang) {
      _origSetLangEditorial(lang);
      applyEditorialHeroAccent();
    };

    const _origInitEditorial = initApp;
    initApp = async function() {
      await _origInitEditorial();
      applyEditorialHeroAccent();
    };

    window.addEventListener("DOMContentLoaded", initApp);
  </script>
</body>
</html>