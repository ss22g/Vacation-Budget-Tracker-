        launchTitle: "मास्टर रणनीति और लाभ पूर्वानुमान उत्पन्न करें",
        launchDesc: "मिट्टी, मौसम, ICAR क्षेत्रीय फ़िल्टर, लाइव एगमार्कनेट मंडी भाव और एआई स्पष्टीकरण का विश्लेषण।",
        btnGenerate: "विश्लेषण और रणनीति उत्पन्न करें",
        trust1: "तेज़ जानकारी",
        trust2: "बेहतर निर्णय",
        trust3: "अधिक मुनाफा",
        trust4: "टिकाऊ खेती",
        intelHeading: "फसल अनुशंसा और मंडी बुद्धिमत्ता",
        emptyTitle: "आपकी फसल रणनीति के लिए तैयार",
        emptyDesc: "ऊपर अपनी मिट्टी या मौसम की जानकारी चुनें और विश्लेषण बटन दबाएं।",
        emptyBtn: "तुरंत विश्लेषण करें",
        btnVoice: "बोलती सलाह",
        kpiLive: "वर्तमान लाइव मंडी भाव",
        kpiRange: "बाजार मूल्य सीमा",
        kpiRevenue: "अनुमानित कुल आय",
        histTitle: "मूल्य इतिहास (पिछले 7 दिन)",
        foreTitle: "14-दिन का मूल्य पूर्वानुमान",
        foreSub: "अनुमानित मंडी मूल्य रुझान",
        xaiTitle: "एआई स्पष्टीकरण (Explainable AI)",
        xaiSub: "समझें यह फसल क्यों सुझाई गई है",
        qualTitle: "फसल गुणवत्ता मूल्यांकन एआई",
        qualSub: "स्वास्थ्य, ग्रेड और उपज जोखिम जांच",
        targetMetric: "लक्ष्य मानदंड:",
        actionPlanTitle: "खेत के लिए व्यावहारिक सुझाव",
        notifTitle: "लाइव खेत अलर्ट",
        rankNames: ["प्राथमिक रणनीति", "वैकल्पिक विकल्प A", "वैकल्पिक विकल्प B"],
      },
    };

    const state = {
      lang: "EN",
      theme: localStorage.getItem("agri_theme_v2") || "light",
      soilMethod: "lab",
      bootstrap: null,
      soilAlerts: [],
      prediction: null,
      activeRankIdx: 0,
      forecastDays: 14,
      journey: [],
      chatOpen: false,
      chatBusy: false,
      messages: [
        {
          role: "assistant",
          time: nowClock(),
          voice_lang: "hi",
          spoken_text:
            "नमस्ते किसान भाई! मैं किसान सहायक ए आई हूं, आपका अपना खेती सलाहकार। आप हिंदी, हिंग्लिश या इंग्लिश में बोलकर या लिखकर मिट्टी, मौसम और मंडी भाव के बारे में कुछ भी पूछ सकते हैं।",
          content:
            "### 🌱 Namaste Kisan Bhai!\nMain **Kisan Sahayak AI** hoon — aapka smart digital kheti sahayak.\n- **Languages:** English, हिंदी, ya Hinglish mein baat karein.\n- **Live Screen Aware:** Soil N-P-K, pH alerts, aur Mandi bhav turant samjhein.\n- **Smart Savings:** Khad bachane aur munafa badhane ke asaan upay paayein.\n> [!TIP] Upar apna Soil Report ya City chunein aur **Analyze** dabayein — phir mujhse kuch bhi poochein!",
        },
      ],
    };

    let forecastChart = null;
    let soilAlertTimer = null;

    function refreshIcons() {
      if (window.lucide) window.lucide.createIcons();
    }

    function nowClock() {
      return new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
    }

    function logStep(action, detail) {
      const tag = `${action}: ${detail}`;
      const ts = new Date().toLocaleTimeString([], { hour12: false });
      const last = state.journey[state.journey.length - 1];
      if (!last || !last.endsWith(tag)) {
        state.journey.push(`[${ts}] ${tag}`);
        if (state.journey.length > 30) state.journey.shift();
      }
    }

    function escapeHtml(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function formatInlineSafe(escapedLine) {
      let s = escapedLine;
      s = s.replace(/`([^`]+)`/g, '<code class="ai-code">$1</code>');
      s = s.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
      s = s.replace(/(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)/g, "<em>$1</em>");
      // Highlight rupee prices & percentages cleanly outside tags
      s = s.replace(/(₹[\d,]+(?:\.\d+)?(?:\/[A-Za-z]+)?)/g, '<span class="ai-pill">$1</span>');
      s = s.replace(/(\b\d+(?:\.\d+)?%)/g, '<span class="ai-pill">$1</span>');
      return s;
    }

    function formatMd(raw, richMode = true) {
      // Layer 1: Strictly escape ALL raw HTML entities first (prevents any XSS injection)
      const escaped = String(raw ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

      if (!richMode) {
        return escaped
          .split("\n")
          .filter((l) => l.trim())
          .map((l) => `<p>${l}</p>`)
          .join("");
      }

      const lines = escaped.split("\n");
      let out = "";
      let listType = null;

      const closeList = () => {
        if (listType) {
          out += listType === "ul" ? "</ul>" : "</ol>";
          listType = null;
        }
      };

      for (const rawLine of lines) {
        const tr = rawLine.trim();
        if (!tr) {
          closeList();
          continue;
        }

        // Safe Callout Blocks: > [!TIP], > [!WARN], > [!PROFIT]
        const calloutMatch = tr.match(/^&gt;\s*\[!(TIP|WARN|PROFIT)\]\s*(.*)$/i);
        if (calloutMatch) {
          closeList();
          const kind = calloutMatch[1].toLowerCase();
          const iconMap = { tip: "lightbulb", warn: "alert-triangle", profit: "trending-up" };
          out += `<div class="ai-callout ${kind}"><i data-lucide="${iconMap[kind]}"></i><span>${formatInlineSafe(calloutMatch[2])}</span></div>`;
          continue;
        }

        // Standard Blockquote
        if (tr.startsWith("&gt;")) {
          closeList();
          out += `<div class="ai-callout quote"><span>${formatInlineSafe(tr.replace(/^&gt;\s*/, ""))}</span></div>`;
          continue;
        }

        // Section Headings (#, ##, ###)
        const headMatch = tr.match(/^#{1,3}\s+(.+)$/);
        if (headMatch) {
          closeList();
          out += `<h4 class="ai-h">${formatInlineSafe(headMatch[1])}</h4>`;
          continue;
        }

        // Unordered Bullet List
        if (/^([-*•])\s+/.test(tr)) {
          if (listType !== "ul") {
            closeList();
            out += '<ul class="ai-ul">';
            listType = "ul";
          }
          out += `<li>${formatInlineSafe(tr.replace(/^([-*•])\s+/, ""))}</li>`;
          continue;
        }

        // Ordered Numbered Steps
        if (/^\d+\.\s+/.test(tr)) {
          if (listType !== "ol") {
            closeList();
            out += '<ol class="ai-ol">';
            listType = "ol";
          }
          out += `<li>${formatInlineSafe(tr.replace(/^\d+\.\s+/, ""))}</li>`;
          continue;
        }

        closeList();
        out += `<p>${formatInlineSafe(tr)}</p>`;
      }
      closeList();

      // Layer 2: DOMPurify strict allowlist defense-in-depth
      if (window.DOMPurify) {
        return window.DOMPurify.sanitize(out, {
          ALLOWED_TAGS: ["h4", "p", "div", "span", "strong", "em", "code", "ul", "ol", "li", "i", "br"],
          ALLOWED_ATTR: ["class", "data-lucide"],
        });
      }
      return out;
    }

    function fmtINR(v) {
      return "₹" + Number(v || 0).toLocaleString("en-IN", { maximumFractionDigits: 2 });
    }

    /* ---------------- HEADER MENUS, THEME & LANGUAGE ---------------- */
    function closeMenus() {
      document.getElementById("notifMenu").classList.remove("open");
      document.getElementById("profileMenu").classList.remove("open");
    }

    function toggleMenu(id) {
      const target = document.getElementById(id);
      const isOpen = target.classList.contains("open");
      closeMenus();
      if (!isOpen) target.classList.add("open");
      if (id === "notifMenu") document.getElementById("notifDot").style.display = "none";
    }

    document.addEventListener("click", (e) => {
      if (!e.target.closest(".topbar-actions")) closeMenus();
    });

    function addNotification(title, body) {
      const list = document.getElementById("notifList");
      const item = document.createElement("div");
      item.className = "notif-item";
      item.innerHTML = `<strong>${escapeHtml(title)}</strong>${escapeHtml(body)}`;
      list.prepend(item);
      while (list.children.length > 5) list.lastChild.remove();
      document.getElementById("notifDot").style.display = "block";
    }

    function applyTheme(theme) {
      state.theme = theme;
      document.documentElement.setAttribute("data-theme", theme);
      localStorage.setItem("agri_theme_v2", theme);
      const btn = document.getElementById("themeBtn");
      btn.innerHTML = `<i data-lucide="${theme === "dark" ? "sun" : "moon"}"></i>`;
      refreshIcons();
      if (state.prediction) renderActiveStrategy();
    }

    function toggleTheme() {
      applyTheme(state.theme === "dark" ? "light" : "dark");
      logStep("Switched Theme", state.theme);
    }

    function setLanguage(lang) {
      state.lang = lang;
      document.getElementById("langEN").classList.toggle("active", lang === "EN");
      document.getElementById("langHI").classList.toggle("active", lang === "HI");
      const dict = I18N[lang];
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n");
        if (dict[key]) el.textContent = dict[key];
      });
      if (state.prediction) renderRecCards();
      logStep("Selected UI Language", lang);
    }

    function scrollToSection(id) {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function mobileNav(tab) {
      document.querySelectorAll(".m-nav-btn").forEach((b) => b.classList.remove("active"));
      if (tab === "home") {
        document.getElementById("mNavHome").classList.add("active");
        toggleChat(false);
        scrollToSection("top");
      } else if (tab === "market") {
        document.getElementById("mNavMarket").classList.add("active");
        toggleChat(false);
        scrollToSection("marketSection");
      } else if (tab === "analyze") {
        toggleChat(false);
        generateMasterStrategy();
      } else if (tab === "advisor") {
        document.getElementById("mNavAdvisor").classList.add("active");
        toggleChat();
      } else if (tab === "more") {
        document.getElementById("mNavMore").classList.add("active");
        toggleMenu("profileMenu");
      }
    }

    /* ---------------- SOIL PROFILE LOGIC ---------------- */
    function getCurrentSoilValues() {
      if (state.soilMethod === "regional" && state.bootstrap) {
        const d = state.bootstrap.soil_archetypes[document.getElementById("soilTypeSelect").value];
        return { N: d.N, P: d.P, K: d.K, ph: d.pH };
      }
      if (state.soilMethod === "visual" && state.bootstrap) {
        const d = state.bootstrap.visual_symptoms[document.getElementById("symptomSelect").value];
        return { N: d.N, P: d.P, K: d.K, ph: d.pH };
      }
      return {
        N: parseFloat(document.getElementById("inN").value) || 0,
        P: parseFloat(document.getElementById("inP").value) || 2,
        K: parseFloat(document.getElementById("inK").value) || 2,
        ph: parseFloat(document.getElementById("inPH").value) || 6.5,
      };
    }

    function syncLabInputs(N, P, K, ph) {
      document.getElementById("inN").value = N; document.getElementById("rngN").value = N;
      document.getElementById("inP").value = P; document.getElementById("rngP").value = P;
      document.getElementById("inK").value = K; document.getElementById("rngK").value = K;
      document.getElementById("inPH").value = ph; document.getElementById("rngPH").value = ph;
      updatePhBanner();
    }

    function updatePhBanner() {
      const { ph } = getCurrentSoilValues();
      const box = document.getElementById("phHighlight");
      const title = document.getElementById("phStatusTitle");
      const desc = document.getElementById("phStatusDesc");
      document.getElementById("phDisplayVal").textContent = `pH ${Number(ph).toFixed(1)}`;

      if (ph >= 6.0 && ph <= 7.5) {
        box.className = "ph-highlight optimal";
        title.textContent = "Optimal Soil Reaction (pH 6.0 – 7.5)";
        desc.textContent = "Maximum availability of essential N-P-K macronutrients.";
      } else if (ph < 6.0) {
        box.className = "ph-highlight";
        title.textContent = "Acidic Soil Reaction (pH < 6.0)";
        desc.textContent = "Consider agricultural lime (CaCO₃) to balance soil acidity.";
      } else {
        box.className = "ph-highlight";
        title.textContent = "Alkaline Soil Reaction (pH > 7.5)";
        desc.textContent = "Consider gypsum and organic compost to improve nutrient uptake.";
      }
    }

    function setSoilMethod(method) {
      state.soilMethod = method;
      document.querySelectorAll(".tab-btn").forEach((b) =>
        b.classList.toggle("active", b.dataset.method === method)
      );
      document.getElementById("soilPanelLab").style.display = method === "lab" ? "block" : "none";
      document.getElementById("soilPanelRegional").style.display = method === "regional" ? "block" : "none";
      document.getElementById("soilPanelVisual").style.display = method === "visual" ? "block" : "none";
      logStep("Soil Input Method", method);
      updatePhBanner();
      refreshSoilAlerts();
    }

    function updateSoilTypeInfo() {
      const key = document.getElementById("soilTypeSelect").value;
      const d = state.bootstrap.soil_archetypes[key];
      document.getElementById("soilTypeInfo").innerHTML = `
        <div><strong>Texture:</strong> ${escapeHtml(d.texture)} &nbsp;&bull;&nbsp; <strong>Organic Carbon:</strong> ${escapeHtml(d.organic_carbon)}</div>
        <div><strong>Drainage:</strong> ${escapeHtml(d.permeability)}</div>
        <div><strong>Field Note:</strong> ${escapeHtml(d.limiting_note)}</div>
        <div class="chip-row">
          <span class="mini-chip">N: ${d.N}</span>
          <span class="mini-chip">P: ${d.P}</span>
          <span class="mini-chip">K: ${d.K}</span>
          <span class="mini-chip">pH: ${d.pH}</span>
        </div>`;
      logStep("Selected Soil Type", key);
      updatePhBanner();
      refreshSoilAlerts();
    }

    function updateSymptomInfo() {
      const key = document.getElementById("symptomSelect").value;
      const d = state.bootstrap.visual_symptoms[key];
      document.getElementById("symptomInfo").innerHTML = `
        <div><strong>Inferred Diagnosis:</strong> ${escapeHtml(d.diagnosis)}</div>
        <div><strong>Corrective Action:</strong> ${escapeHtml(d.recommendation)}</div>
        <div class="chip-row">
          <span class="mini-chip">N: ${d.N}</span>
          <span class="mini-chip">P: ${d.P}</span>
          <span class="mini-chip">K: ${d.K}</span>
          <span class="mini-chip">pH: ${d.pH}</span>
        </div>`;
      logStep("Selected Leaf Symptom", key);
      updatePhBanner();
      refreshSoilAlerts();
    }

    function refreshSoilAlerts() {
      clearTimeout(soilAlertTimer);
      soilAlertTimer = setTimeout(async () => {
        try {
          const res = await fetch("/api/soil-alerts", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(getCurrentSoilValues()),
          });
          const data = await res.json();
          state.soilAlerts = data.alerts || [];
          document.getElementById("soilAlertsBox").innerHTML = state.soilAlerts
            .map((a) => `<div class="alert-row">${formatMd(a)}</div>`)
            .join("");
        } catch (e) {}
      }, 180);
    }

    /* ---------------- WEATHER & REGION LOGIC ---------------- */
    function updateHeaderLoc(cityLabel) {
      const zoneKey = document.getElementById("zoneSelect").value;
      const r = state.bootstrap?.regions[zoneKey];
      const stateName = r?.state || "India";
      const place = cityLabel || r?.station || "Prayagraj";
      document.getElementById("headerLocation").textContent = `${stateName} • ${place}`;
    }

    function updateWeatherInsight() {
      const t = parseFloat(document.getElementById("inTemp").value) || 26;
      const h = parseFloat(document.getElementById("inHum").value) || 68;
      const el = document.getElementById("weatherInsightText");
      if (t >= 18 && t <= 32 && h >= 45 && h <= 85) {
        el.textContent = "Weather window is well balanced for seasonal sowing & healthy germination.";
      } else if (h < 40) {
        el.textContent = "Low atmospheric humidity detected — plan drip/furrow irrigation & mulching.";
      } else if (t > 35) {
        el.textContent = "High daytime temperature — prioritize heat-tolerant crops and moisture retention.";
      } else {
        el.textContent = "Climate telemetry calibrated — ready for crop suitability analysis.";
      }
    }

    function updateRegionMeta(syncBaselines = true) {
      const zoneKey = document.getElementById("zoneSelect").value;
      const seasonKey = document.getElementById("seasonSelect").value;
      const r = state.bootstrap.regions[zoneKey];
      const s = state.bootstrap.seasons[seasonKey];

      document.getElementById("regionMetaInfo").innerHTML = `
        <div><strong>ICAR Zone:</strong> ${escapeHtml(r.zone)} &nbsp;&bull;&nbsp; <strong>Regional Soil:</strong> ${escapeHtml(r.soil)}</div>
        <div><strong>Season Filter:</strong> ${escapeHtml(s.description)}</div>`;

      updateHeaderLoc(r.station);

      if (syncBaselines) {
        document.getElementById("inTemp").value = r.base_temp;
        document.getElementById("inHum").value = r.base_hum;
        document.getElementById("inRain").value = r.base_rain;
        document.getElementById("telemetrySource").textContent = `IMD Regional Baseline (${r.station})`;
        document.getElementById("telemetryUpdated").textContent = `Updated ${nowClock()}`;
        syncLabInputs(r.def_N, r.def_P, r.def_K, r.def_pH);
        updateWeatherInsight();
        refreshSoilAlerts();
      }
    }

    async function fetchSatelliteWeather() {
      const btn = document.getElementById("btnAutoFetch");
      const zoneKey = document.getElementById("zoneSelect").value;
      btn.disabled = true;
      try {
        const res = await fetch("/api/weather", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ selected_zone: zoneKey, search_text: "" }),
        });
        const w = await res.json();
        document.getElementById("inTemp").value = w.temperature;
        document.getElementById("inHum").value = w.humidity;
        document.getElementById("inRain").value = w.rainfall;
        document.getElementById("telemetrySource").textContent = w.source;
        document.getElementById("telemetryUpdated").textContent = `Updated ${nowClock()}`;
        updateWeatherInsight();
        logStep("Auto-Fetched Satellite Weather", `${w.source} (${w.temperature}°C, ${w.humidity}%)`);
        addNotification("Satellite Telemetry Synced", `${w.source}: ${w.temperature}°C, ${w.humidity}% humidity.`);
      } finally {
        btn.disabled = false;
      }
    }

    async function lockPrayagraj() {
      const prayagKey = "Uttar Pradesh (Eastern / Prayagraj / Varanasi)";
      const sel = document.getElementById("zoneSelect");
      if (state.bootstrap?.regions[prayagKey]) {
        sel.value = prayagKey;
        updateRegionMeta(false);
      }
      document.getElementById("citySearchInput").value = "Prayagraj";
      updateHeaderLoc("Prayagraj");
      const res = await fetch("/api/weather", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ selected_zone: prayagKey, search_text: "Allahabad" }),
      });
      const w = await res.json();
      document.getElementById("inTemp").value = w.temperature;
      document.getElementById("inHum").value = w.humidity;
      document.getElementById("inRain").value = w.rainfall;
      document.getElementById("telemetrySource").textContent = w.source;
      document.getElementById("telemetryUpdated").textContent = `Updated ${nowClock()}`;
      updateWeatherInsight();
      logStep("Clicked Lock Prayagraj", `${w.temperature}°C, ${w.humidity}% Hum`);
      addNotification("Location Locked", `Prayagraj weather synced (${w.temperature}°C, ${w.humidity}% Hum).`);
    }

    async function searchCityWeather() {
      const city = document.getElementById("citySearchInput").value.trim();
      if (!city) return;
      const btn = document.getElementById("btnCitySearch");
      btn.disabled = true;
      try {
        const zoneKey = document.getElementById("zoneSelect").value;
        const res = await fetch("/api/weather", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ selected_zone: zoneKey, search_text: city }),
        });
        const w = await res.json();
        document.getElementById("inTemp").value = w.temperature;
        document.getElementById("inHum").value = w.humidity;
        document.getElementById("inRain").value = w.rainfall;
        document.getElementById("telemetrySource").textContent = w.source;
        document.getElementById("telemetryUpdated").textContent = `Updated ${nowClock()}`;
        updateHeaderLoc(city);
        updateWeatherInsight();
        logStep("Searched City Weather", `${city} -> ${w.source}`);
        addNotification(`City Weather: ${city}`, `${w.temperature}°C, ${w.humidity}% humidity, ${w.rainfall} mm rainfall.`);
      } finally {
        btn.disabled = false;
      }
    }

    function quickCity(city, btnEl) {
      document.querySelectorAll(".city-chip").forEach((c) => c.classList.remove("active"));
      if (btnEl) btnEl.classList.add("active");
      document.getElementById("citySearchInput").value = city;
      searchCityWeather();
    }

    function resetToDefaults() {
      document.getElementById("citySearchInput").value = "";
      setSoilMethod("lab");
      updateRegionMeta(true);
      logStep("Reset Inputs", "Restored regional defaults");
    }

    /* ---------------- MASTER STRATEGY PREDICTION ---------------- */
    async function generateMasterStrategy() {
      const btn = document.getElementById("btnGenerate");
      const empty = document.getElementById("emptyState");
      const skel = document.getElementById("skeletonWrap");
      const results = document.getElementById("resultsSection");

      btn.disabled = true;
      empty.style.display = "none";
      results.classList.remove("show");
      skel.classList.add("show");
      scrollToSection("marketSection");

      const soil = getCurrentSoilValues();
      const payload = {
        N: soil.N,
        P: soil.P,
        K: soil.K,
        ph: soil.ph,
        temperature: parseFloat(document.getElementById("inTemp").value) || 26.5,
        humidity: parseFloat(document.getElementById("inHum").value) || 68.0,
        rainfall: parseFloat(document.getElementById("inRain").value) || 195.0,
        selected_zone: document.getElementById("zoneSelect").value,
        selected_season: document.getElementById("seasonSelect").value,
        city_name: document.getElementById("citySearchInput").value.trim(),
      };

      try {
        const [data] = await Promise.all([
          fetch("/api/predict", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          }).then((r) => r.json()),
          new Promise((r) => setTimeout(r, 420)),
        ]);

        state.prediction = data;
        state.activeRankIdx = 0;

        const summary = data.strategies
          .map((s, idx) => `#${idx + 1} ${s.crop} (${s.match_percent}%)`)
          .join(", ");
        logStep("Generated Master Strategy", summary);
        addNotification("Strategy Ready", `Top recommendation: ${data.strategies[0].crop} (${data.strategies[0].match_percent}%).`);

        renderRecCards();
        renderActiveStrategy();
        skel.classList.remove("show");
        results.classList.add("show");
      } catch (err) {
        skel.classList.remove("show");
        empty.style.display = "block";
        alert("Could not reach FastAPI server.py. Ensure uvicorn is running on port 8000.");
      } finally {
        btn.disabled = false;
      }
    }

    function renderRecCards() {
      const grid = document.getElementById("recCardsGrid");
      const rankNames = I18N[state.lang].rankNames;
      const icons = ["sprout", "leaf", "wheat"];
      grid.innerHTML = state.prediction.strategies
        .map(
          (s, idx) => `
          <button class="rec-card ${idx === state.activeRankIdx ? "active" : ""}" onclick="selectStrategy(${idx})">
            <div class="rec-left">
              <div class="rec-ico"><i data-lucide="${icons[idx]}"></i></div>
              <div>
                <div class="rec-rank">${rankNames[idx]}</div>
                <div class="rec-crop">${escapeHtml(s.crop)}</div>
              </div>
            </div>
            <div class="rec-score">${s.match_percent}%</div>
          </button>`
        )
        .join("");
      refreshIcons();
    }

    function selectStrategy(idx) {
      state.activeRankIdx = idx;
      const s = state.prediction.strategies[idx];
      logStep("Viewed Strategy Card", `${I18N.EN.rankNames[idx]} (${s.crop})`);
      renderRecCards();
      renderActiveStrategy();
    }

    function setForecastDays(days) {
      state.forecastDays = days;
      document.getElementById("rng7D").classList.toggle("active", days === 7);
      document.getElementById("rng14D").classList.toggle("active", days === 14);
      if (state.prediction) {
        const s = state.prediction.strategies[state.activeRankIdx];
        renderForecastChart(s.mandi.forecast.slice(0, days));
      }
    }

    function buildDynamicRecommendations(strategy) {
      const recs = [];
      const lowRows = strategy.xai.filter((r) => r.status === "low");
      const highRows = strategy.xai.filter((r) => r.status === "warn");

      for (const row of lowRows) {
        const f = row.factor.toLowerCase();
        if (f === "n") recs.push(`Nitrogen (${row.field_value}) is below ideal (${row.ideal_target}) — split-apply Urea or vermicompost before vegetative growth.`);
        else if (f === "p") recs.push(`Phosphorus (${row.field_value}) is low — apply basal DAP or Single Super Phosphate at sowing for root strength.`);
        else if (f === "k") recs.push(`Potassium (${row.field_value}) is deficient — supplement Muriate of Potash (MOP) to boost grain filling & disease resistance.`);
        else if (f === "humidity" || f === "rainfall") recs.push(`${row.factor} (${row.field_value}) is below target — schedule light irrigation and apply organic mulching to preserve soil moisture.`);
        else recs.push(`Supplement or stabilize ${row.factor} (current ${row.field_value} vs target ${row.ideal_target}) to protect yield potential.`);
      }

      if (highRows.length) {
        const names = highRows.map((r) => r.factor).join(", ");
        recs.push(`Save input costs: ${names} ${highRows.length > 1 ? "are" : "is"} already above ideal (${highRows[0].assessment}) — avoid extra application.`);
      }

      const isBullish = strategy.mandi.sentiment.toLowerCase().includes("bullish");
      recs.push(
        isBullish
          ? `Market trend is Bullish toward ${fmtINR(strategy.mandi.forecast[strategy.mandi.forecast.length - 1].price)}/Q — staggered selling or short-term dry storage may improve margins.`
          : `Market supply is currently high — monitor local APMC arrivals closely or lock MSP procurement early.`
      );

      return recs.slice(0, 4);
    }

    function renderActiveStrategy() {
      const s = state.prediction.strategies[state.activeRankIdx];
      const m = s.mandi;

      document.getElementById("heroCropName").textContent = s.crop;
      document.getElementById("heroMatchTag").innerHTML = `<i data-lucide="target"></i> ${s.match_percent}% Biological Match`;
      document.getElementById("heroSeasonTag").textContent = s.season_badge;
      document.getElementById("heroDistrictTag").textContent = `${state.prediction.district}, ${state.prediction.state}`;

      document.getElementById("kpiModalPrice").textContent = fmtINR(m.current_price);
      document.getElementById("kpiPriceRange").textContent = `${fmtINR(m.min_price)} – ${fmtINR(m.max_price)}`;
      document.getElementById("kpiMandis").textContent = `Across ${m.mandis_count} Mandis`;
      document.getElementById("kpiGrossRev").textContent = fmtINR(m.est_revenue);
      document.getElementById("kpiYield").textContent = `Yield: ${Number(m.expected_yield_kg).toLocaleString("en-IN")} kg/ha`;

      document.getElementById("mandiSourceLabel").textContent = m.source_label;
      document.getElementById("historyTableBody").innerHTML = m.history
        .map(
          (row) => `
          <tr>
            <td>${escapeHtml(row.date)}</td>
            <td>${fmtINR(row.price)}</td>
            <td>${Number(row.arrival).toLocaleString("en-IN")}</td>
          </tr>`
        )
        .join("");

      const isBullish = m.sentiment.toLowerCase().includes("bullish");
      const sb = document.getElementById("sentimentBadge");
      sb.className = `sentiment-pill ${isBullish ? "bullish" : "bearish"}`;
      sb.innerHTML = `<i data-lucide="${isBullish ? "trending-up" : "trending-down"}"></i> <span>${escapeHtml(m.sentiment)}</span>`;

      renderForecastChart(m.forecast.slice(0, state.forecastDays));

      // Key Focus Strip
      const kf = document.getElementById("keyFocusBanner");
      if (s.key_focus_assessment.includes("LOW")) {
        kf.className = "status-strip red";
        kf.innerHTML = `<span class="status-strip-left"><i data-lucide="alert-triangle"></i><span><strong>Key Focus Factor:</strong> ${escapeHtml(s.key_focus_factor)} is below optimal range (${escapeHtml(s.key_focus_assessment)}). Supplementation advised.</span></span>`;
      } else if (s.key_focus_assessment.includes("HIGH")) {
        kf.className = "status-strip saffron";
        kf.innerHTML = `<span class="status-strip-left"><i data-lucide="info"></i><span><strong>Parameter Note:</strong> ${escapeHtml(s.key_focus_factor)} is above average (${escapeHtml(s.key_focus_assessment)}), within tolerable bounds.</span></span>`;
      } else {
        kf.className = "status-strip green";
        kf.innerHTML = `<span class="status-strip-left"><i data-lucide="check-circle-2"></i><span><strong>Nutrient Synergy:</strong> Soil and climate profiles align closely with ${escapeHtml(s.crop)}.</span></span>`;
      }

      document.getElementById("xaiTableBody").innerHTML = s.xai
        .map(
          (row) => `
          <tr>
            <td><span class="status-dot ${row.status}"></span></td>
            <td>${escapeHtml(row.factor)}</td>
            <td>${row.field_value}</td>
            <td>${escapeHtml(row.ideal_target)}</td>
            <td>
              <div class="bar-cell">
                <div class="bar-track"><div class="bar-fill ${row.status}" style="width:${row.fit}%"></div></div>
                <span class="bar-num">${row.fit}%</span>
              </div>
            </td>
            <td><span class="badge ${row.status}">${escapeHtml(row.assessment)}</span></td>
          </tr>`
        )
        .join("");

      document.getElementById("qualityMetricText").textContent = s.quality.metric;
      const qBox = document.getElementById("qualityVerdictBox");
      const qIco = s.quality.level === "danger" ? "alert-triangle" : s.quality.level === "warning" ? "alert-circle" : "check-circle-2";
      qBox.className = `quality-banner ${s.quality.level}`;
      qBox.innerHTML = `<i data-lucide="${qIco}"></i><span>${escapeHtml(s.quality.verdict)}</span>`;

      const recs = buildDynamicRecommendations(s);
      document.getElementById("qualityRecsList").innerHTML = recs
        .map((r) => `<li><i data-lucide="check"></i><span>${escapeHtml(r)}</span></li>`)
        .join("");

      refreshIcons();
    }

    function renderForecastChart(points) {
      const peak = Math.max(...points.map((p) => p.price));
      document.getElementById("peakPriceBadge").innerHTML = `<i data-lucide="award"></i> Peak: ${fmtINR(peak)}/Q`;
      refreshIcons();

      const ctx = document.getElementById("forecastCanvas").getContext("2d");
      if (forecastChart) forecastChart.destroy();

      const isDark = state.theme === "dark";
      const gridColor = isDark ? "rgba(255,255,255,0.08)" : "#E2E8F0";
      const tickColor = isDark ? "#94A3B8" : "#64748B";
      const grad = ctx.createLinearGradient(0, 0, 0, 240);
      grad.addColorStop(0, "rgba(11, 107, 58, 0.28)");
      grad.addColorStop(1, "rgba(11, 107, 58, 0.00)");

      forecastChart = new Chart(ctx, {
        type: "line",
        data: {
          labels: points.map((p) => p.date),
          datasets: [
            {
              label: "Predicted Price (₹/Q)",
              data: points.map((p) => p.price),
              borderColor: isDark ? "#34D399" : "#0B6B3A",
              backgroundColor: grad,
              borderWidth: 2.8,
              pointRadius: 3.5,
              pointHoverRadius: 6,
              pointBackgroundColor: isDark ? "#34D399" : "#0B6B3A",
              pointBorderColor: isDark ? "#121D17" : "#FFFFFF",
              pointBorderWidth: 1.5,
              fill: true,
              tension: 0.34,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: "#06381F",
              titleColor: "#FEF3C7",
              bodyColor: "#FFFFFF",
              padding: 10,
              cornerRadius: 10,
              callbacks: {
                label: (c) => ` ₹${Number(c.parsed.y).toLocaleString("en-IN")} / Quintal`,
              },
            },
          },
          scales: {
            x: { grid: { display: false }, ticks: { color: tickColor, font: { size: 11, weight: "600" } } },
            y: {
              grid: { color: gridColor },
              ticks: { color: tickColor, font: { size: 11, weight: "600" }, callback: (v) => "₹" + v },
            },
          },
        },
      });
    }

    /* ---------------- NEURAL VOICE ENGINE + UNIFIED PLAY/STOP & SLIDE SWITCH ---------------- */
    const voiceState = {
      audio: null,
      audioUrl: null,
      abortCtrl: null,
      playbackId: 0,
      status: "idle", // "idle" | "loading" | "playing"
      source: null,   // "chat" | "crop" | null
      autoSpeak: localStorage.getItem("agri_auto_voice") !== "false",
      toastTimer: null,
      recording: false,
      audioCtx: null,
      mediaStream: null,
      processor: null,
      sourceNode: null,
      pcmChunks: [],
      sampleRate: 16000,
      peakAmp: 0,
      timerId: null,
      recSeconds: 0,
    };

    function setVoiceIndicator(active, label = "Kisan Sahayak bol raha hai...") {
      const pill = document.getElementById("voiceSpeakingPill");
      const txt = document.getElementById("voiceStatusText");
      if (txt) txt.textContent = label;
      if (pill) pill.classList.toggle("show", active);
    }

    function flashVoiceNotice(text) {
      clearTimeout(voiceState.toastTimer);
      if (voiceState.status !== "idle") return;
      setVoiceIndicator(true, text);
      voiceState.toastTimer = setTimeout(() => {
        if (voiceState.status === "idle") setVoiceIndicator(false);
      }, 1800);
    }

    function syncVoiceUI() {
      // 1. Unified Chat Play/Stop Morph Button
      const btn = document.getElementById("voicePlayStopBtn");
      if (btn) {
        btn.classList.remove("is-loading", "is-playing");
        if (voiceState.status === "loading") {
          btn.classList.add("is-loading");
          btn.setAttribute("aria-pressed", "true");
          btn.innerHTML = '<i data-lucide="loader-2"></i><span>तैयार...</span>';
        } else if (voiceState.status === "playing") {
          btn.classList.add("is-playing");
          btn.setAttribute("aria-pressed", "true");
          btn.innerHTML = '<span class="v-mini-eq"><span></span><span></span><span></span></span><span>रोकें</span>';
        } else {
          btn.setAttribute("aria-pressed", "false");
          btn.innerHTML = '<i data-lucide="volume-2"></i><span>सुनिए</span>';
        }
      }

      // 2. Unified Crop Banner Voice Advisor Morph Button
      const cropBtn = document.getElementById("cropVoiceBtn");
      if (cropBtn) {
        cropBtn.classList.remove("is-loading", "is-playing");
        const idleLabel = (I18N[state.lang] && I18N[state.lang].btnVoice) || "Voice Advisor";
        if (voiceState.source === "crop" && voiceState.status === "loading") {
          cropBtn.classList.add("is-loading");
          cropBtn.setAttribute("aria-pressed", "true");
          cropBtn.innerHTML = '<i data-lucide="loader-2"></i><span>Preparing...</span>';
        } else if (voiceState.source === "crop" && voiceState.status === "playing") {
          cropBtn.classList.add("is-playing");
          cropBtn.setAttribute("aria-pressed", "true");
          cropBtn.innerHTML = '<i data-lucide="square"></i><span>' + (state.lang === "HI" ? "आवाज़ रोकें" : "Stop Voice") + '</span>';
        } else {
          cropBtn.setAttribute("aria-pressed", "false");
          cropBtn.innerHTML = '<i data-lucide="volume-2"></i><span data-i18n="btnVoice">' + escapeHtml(idleLabel) + '</span>';
        }
      }

      // 3. Auto Mode Tactile Slide Switch
      const wrap = document.getElementById("autoSlideWrap");
      const track = document.getElementById("autoSlideTrack");
      const thumb = document.getElementById("autoSlideThumb");
      if (wrap && track && thumb) {
        wrap.classList.toggle("on", voiceState.autoSpeak);
        track.setAttribute("aria-checked", voiceState.autoSpeak ? "true" : "false");
        thumb.style.transform = "";
        thumb.innerHTML = voiceState.autoSpeak
          ? '<i data-lucide="volume-2"></i>'
          : '<i data-lucide="volume-x"></i>';
      }
      refreshIcons();
    }

    function setAutoSpeak(enabled, showToast = false) {
      const next = Boolean(enabled);
      voiceState.autoSpeak = next;
      localStorage.setItem("agri_auto_voice", next ? "true" : "false");
      syncVoiceUI();
      if (showToast) {
        flashVoiceNotice(
          next
            ? "Auto Voice ON — हर जवाब खुद सुनाई देगा"
            : "Auto Voice OFF — सुनने के लिए 'सुनिए' दबाएँ"
        );
      }
    }

    function toggleAutoSpeak() {
      setAutoSpeak(!voiceState.autoSpeak, true);
    }

    function initAutoSlideSwitch() {
      const track = document.getElementById("autoSlideTrack");
      const thumb = document.getElementById("autoSlideThumb");
      if (!track || !thumb || track.dataset.bound === "1") return;
      track.dataset.bound = "1";

      const MAX_X = 18;
      let startX = 0;
      let baseX = 0;
      let curX = 0;
      let moved = false;
      let activePtr = null;

      track.addEventListener("pointerdown", (e) => {
        activePtr = e.pointerId;
        track.setPointerCapture(activePtr);
        startX = e.clientX;
        baseX = voiceState.autoSpeak ? MAX_X : 0;
        curX = baseX;
        moved = false;
        track.classList.add("dragging");
      });

      track.addEventListener("pointermove", (e) => {
        if (activePtr !== e.pointerId) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 3) moved = true;
        curX = Math.max(0, Math.min(MAX_X, baseX + dx));
        thumb.style.transform = `translateX(${curX}px)`;
      });

      const finishSlide = (e) => {
        if (activePtr !== e.pointerId) return;
        try { track.releasePointerCapture(activePtr); } catch (_) {}
        activePtr = null;
        track.classList.remove("dragging");
        thumb.style.transform = "";

        const nextVal = moved ? curX >= MAX_X / 2 : !voiceState.autoSpeak;
        setAutoSpeak(nextVal, true);
      };

      track.addEventListener("pointerup", finishSlide);
      track.addEventListener("pointercancel", finishSlide);
      track.addEventListener("keydown", (e) => {
        if (e.key === " " || e.key === "Enter") {
          e.preventDefault();
          setAutoSpeak(!voiceState.autoSpeak, true);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          setAutoSpeak(true, true);
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          setAutoSpeak(false, true);
        }
      });

      syncVoiceUI();
    }

    function stopSpeech() {
      voiceState.playbackId += 1;
      clearTimeout(voiceState.toastTimer);
      if (voiceState.abortCtrl) {
        try { voiceState.abortCtrl.abort(); } catch (e) {}
        voiceState.abortCtrl = null;
      }
      if (voiceState.audio) {
        try { voiceState.audio.pause(); voiceState.audio.currentTime = 0; } catch (e) {}
        voiceState.audio = null;
      }
      if (voiceState.audioUrl) {
        URL.revokeObjectURL(voiceState.audioUrl);
        voiceState.audioUrl = null;
      }
      if ("speechSynthesis" in window) window.speechSynthesis.cancel();
      voiceState.status = "idle";
      voiceState.source = null;
      setVoiceIndicator(false);
      syncVoiceUI();
    }

    function pickBestVoice(langHint) {
      const sel = document.getElementById("chatVoiceSelect");
      const chosen = sel ? sel.value : "hi-IN-MadhurNeural";
      if (langHint === "hi" && chosen.startsWith("en-IN")) {
        return chosen.includes("Neerja") ? "hi-IN-SwaraNeural" : "hi-IN-MadhurNeural";
      }
      if (langHint === "en" && chosen.startsWith("hi-IN")) {
        return chosen.includes("Swara") ? "en-IN-NeerjaNeural" : "en-IN-PrabhatNeural";
      }
      return chosen;
    }

    function fallbackBrowserSpeak(text, isHindi, myId) {
      if (!("speechSynthesis" in window) || !text) {
        stopSpeech();
        return;
      }
      const clean = text.replace(/[*_`#>-]/g, " ").replace(/\s+/g, " ").trim();
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(clean);
      utter.lang = isHindi ? "hi-IN" : "en-IN";
      utter.rate = 0.94;
      const voices = window.speechSynthesis.getVoices();
      const match =
        voices.find((v) => v.lang === utter.lang && /google|natural|madhur|swara|prabhat|neerja/i.test(v.name)) ||
        voices.find((v) => v.lang.startsWith(isHindi ? "hi" : "en"));
      if (match) utter.voice = match;
      utter.onstart = () => {
        if (voiceState.playbackId !== myId) return;
        voiceState.status = "playing";
        setVoiceIndicator(true, isHindi ? "Kisan Sahayak bol raha hai..." : "Kisan Sahayak is speaking...");
        syncVoiceUI();
      };
      utter.onend = () => { if (voiceState.playbackId === myId) stopSpeech(); };
      utter.onerror = () => { if (voiceState.playbackId === myId) stopSpeech(); };
      window.speechSynthesis.speak(utter);
    }

    async function speakText(raw, langHint = "hi", source = "chat") {
      if (!raw || !raw.trim()) return;
      stopSpeech();
      const myId = voiceState.playbackId;
      const isHindi = langHint === "hi" || langHint === "hi-IN" || /[\u0900-\u097F]/.test(raw);
      const voice = pickBestVoice(isHindi ? "hi" : "en");

      voiceState.status = "loading";
      voiceState.source = source;
      voiceState.abortCtrl = new AbortController();
      setVoiceIndicator(true, "Aawaz taiyaar ho rahi hai...");
      syncVoiceUI();

      try {
        const res = await fetch("/api/tts", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ text: raw, voice, rate: "-3%" }),
          signal: voiceState.abortCtrl.signal,
        });
        if (voiceState.playbackId !== myId) return;
        if (!res.ok) throw new Error("TTS fallback");
        const blob = await res.blob();
        if (voiceState.playbackId !== myId) return;
        if (!blob || blob.size < 200) throw new Error("Empty TTS");

        const url = URL.createObjectURL(blob);
        voiceState.audioUrl = url;
        const audio = new Audio(url);
        voiceState.audio = audio;

        audio.onplay = () => {
          if (voiceState.playbackId !== myId) return;
          voiceState.status = "playing";
          setVoiceIndicator(true, isHindi ? "Kisan Sahayak bol raha hai..." : "Kisan Sahayak is speaking...");
          syncVoiceUI();
        };
        audio.onended = () => { if (voiceState.playbackId === myId) stopSpeech(); };
        audio.onerror = () => {
          if (voiceState.playbackId !== myId) return;
          fallbackBrowserSpeak(raw, isHindi, myId);
        };
        await audio.play();
      } catch (e) {
        if (e && e.name === "AbortError") return;
        if (voiceState.playbackId === myId) {
          fallbackBrowserSpeak(raw, isHindi, myId);
        }
      }
    }

    function toggleVoicePlayStop() {
      if (voiceState.status === "loading" || voiceState.status === "playing") {
        stopSpeech();
      } else {
        speakLatestChat();
      }
    }

    function toggleCropVoice() {
      if (voiceState.source === "crop" && (voiceState.status === "loading" || voiceState.status === "playing")) {
        stopSpeech();
      } else {
        speakCropSummary();
      }
    }

    function speakCropSummary() {
      if (!state.prediction) return;
      const s = state.prediction.strategies[state.activeRankIdx];
      const m = s.mandi;
      if (state.lang === "HI") {
        speakText(
          `नमस्ते किसान भाई। आपकी मिट्टी और मौसम के हिसाब से ${s.crop} की फसल ${s.match_percent} प्रतिशत अनुकूल है। अभी मंडी में इसका औसत भाव ${Math.round(m.current_price)} रुपये प्रति क्विंटल चल रहा है, और प्रति हेक्टेयर करीब ${Math.round(m.est_revenue)} रुपये की कुल आमदनी हो सकती है। बस ${s.key_focus_factor} पर थोड़ा ध्यान रखिए, उपज शानदार मिलेगी।`,
          "hi",
          "crop"
        );
      } else {
        speakText(
          `Namaste! Based on your field soil and weather, ${s.crop} is a ${s.match_percent} percent match. Right now the mandi rate is around ${Math.round(m.current_price)} rupees per quintal, which gives an estimated gross revenue of ${Math.round(m.est_revenue)} rupees per hectare. Keep an eye on ${s.key_focus_factor} for the best harvest.`,
          "en",
          "crop"
        );
      }
      logStep("Played Neural Voice Advisor", s.crop);
    }

    function speakLatestChat() {
      const latest = [...state.messages].reverse().find((m) => m.role === "assistant");
      if (!latest) return;
      const textToSay = latest.spoken_text || latest.content;
      const langHint = latest.voice_lang || (/[\u0900-\u097F]/.test(textToSay) ? "hi" : "en");
      speakText(textToSay, langHint, "chat");
    }

    /* ---------------- CLEAN 16kHz WAV MIC RECORDER ---------------- */
    function encodeMonoWav(chunks, srcRate, targetRate = 16000) {
      let total = 0;
      for (const c of chunks) total += c.length;
      const merged = new Float32Array(total);
      let off = 0;
      for (const c of chunks) { merged.set(c, off); off += c.length; }

      const ratio = srcRate / targetRate;
      const newLen = Math.max(1, Math.round(merged.length / ratio));
      const down = new Float32Array(newLen);
      for (let i = 0; i < newLen; i++) {
        down[i] = merged[Math.min(merged.length - 1, Math.round(i * ratio))];
      }

      const buf = new ArrayBuffer(44 + down.length * 2);
      const view = new DataView(buf);
      const writeStr = (pos, str) => { for (let i = 0; i < str.length; i++) view.setUint8(pos + i, str.charCodeAt(i)); };
      writeStr(0, "RIFF");
      view.setUint32(4, 36 + down.length * 2, true);
      writeStr(8, "WAVE");
      writeStr(12, "fmt ");
      view.setUint32(16, 16, true);
      view.setUint16(20, 1, true);
      view.setUint16(22, 1, true);
      view.setUint32(24, targetRate, true);
      view.setUint32(28, targetRate * 2, true);
      view.setUint16(32, 2, true);
      view.setUint16(34, 16, true);
      writeStr(36, "data");
      view.setUint32(40, down.length * 2, true);

      let idx = 44;
      for (let i = 0; i < down.length; i++, idx += 2) {
        const s = Math.max(-1, Math.min(1, down[i]));
        view.setInt16(idx, s < 0 ? s * 0x8000 : s * 0x7FFF, true);
      }
      return buf;
    }

    function arrayBufferToBase64(buffer) {
      const bytes = new Uint8Array(buffer);
      let binary = "";
      const step = 0x8000;
      for (let i = 0; i < bytes.length; i += step) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + step));
      }
      return btoa(binary);
    }

    async function toggleVoiceRecording() {
      if (voiceState.recording) {
        await stopVoiceRecording();
        return;
      }
      if (state.chatBusy) return;
      stopSpeech();

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        alert("Browser microphone permission is unavailable. Please allow mic access or type your question.");
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } });
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const ctx = new AudioCtx();
        const src = ctx.createMediaStreamSource(stream);
        const proc = ctx.createScriptProcessor(4096, 1, 1);

        voiceState.mediaStream = stream;
        voiceState.audioCtx = ctx;
        voiceState.sourceNode = src;
        voiceState.processor = proc;
        voiceState.pcmChunks = [];
        voiceState.peakAmp = 0;
        voiceState.sampleRate = ctx.sampleRate || 48000;
        voiceState.recording = true;
        voiceState.recSeconds = 0;

        proc.onaudioprocess = (e) => {
          if (!voiceState.recording) return;
          const data = e.inputBuffer.getChannelData(0);
          voiceState.pcmChunks.push(new Float32Array(data));
          let localPeak = 0;
          for (let i = 0; i < data.length; i++) {
            const a = Math.abs(data[i]);
            if (a > localPeak) localPeak = a;
          }
          if (localPeak > voiceState.peakAmp) voiceState.peakAmp = localPeak;
          const meter = document.getElementById("micMeterFill");
          if (meter) meter.style.width = `${Math.min(100, Math.max(8, Math.round(localPeak * 280)))}%`;
        };

        src.connect(proc);
        proc.connect(ctx.destination);

        document.getElementById("micBtn").classList.add("recording");
        document.getElementById("micLiveBar").classList.add("show");
        document.getElementById("micTimer").textContent = "0s";

        voiceState.timerId = setInterval(() => {
          voiceState.recSeconds += 1;
          document.getElementById("micTimer").textContent = `${voiceState.recSeconds}s`;
          if (voiceState.recSeconds >= 18) stopVoiceRecording();
        }, 1000);
      } catch (err) {
        alert("Microphone access denied. Please allow mic permission in your browser bar.");
      }
    }

    async function stopVoiceRecording() {
      if (!voiceState.recording) return;
      voiceState.recording = false;
      clearInterval(voiceState.timerId);

      try {
        voiceState.processor.disconnect();
        voiceState.sourceNode.disconnect();
        voiceState.mediaStream.getTracks().forEach((t) => t.stop());
        await voiceState.audioCtx.close();
      } catch (e) {}

      document.getElementById("micBtn").classList.remove("recording");
      document.getElementById("micLiveBar").classList.remove("show");

      if (voiceState.peakAmp < 0.012 || voiceState.pcmChunks.length === 0) {
        state.messages.push({
          role: "assistant",
          time: nowClock(),
          voice_lang: "hi",
          spoken_text: "माइक से आपकी आवाज़ साफ़ नहीं आई किसान भाई। कृपया थोड़ा पास से बोलें या नीचे लिखकर पूछें।",
          content: "> [!WARN] **Aawaz nahi sunai di:** Mic se koi clear sound record nahi hua. Kripya thoda paas se bolein ya type karke poochein.",
        });
        renderChatFeed(false);
        if (voiceState.autoSpeak) speakLatestChat();
        return;
      }

      const wavBuf = encodeMonoWav(voiceState.pcmChunks, voiceState.sampleRate, 16000);
      const b64 = arrayBufferToBase64(wavBuf);

      setVoiceIndicator(true, "Aapki aawaz samajh raha hoon...");
      try {
        const res = await fetch("/api/voice-transcribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ audio_b64: b64, mime_type: "audio/wav" }),
        });
        const data = await res.json();
        setVoiceIndicator(false);

        if (data.silent || !data.transcript) {
          state.messages.push({
            role: "assistant",
            time: nowClock(),
            voice_lang: "hi",
            spoken_text: "आवाज़ साफ़ समझ नहीं आई किसान भाई। कृपया एक बार फिर आराम से बोलें।",
            content: "> [!WARN] Aawaz saaf samajh nahi aayi. Kripya thoda saaf bolein ya type karein.",
          });
          renderChatFeed(false);
          if (voiceState.autoSpeak) speakLatestChat();
          return;
        }

        await sendChatMessage(data.transcript, true);
      } catch (e) {
        setVoiceIndicator(false);
      }
    }

    /* ---------------- KISAN SAHAYAK AI CHATBOT ---------------- */
    function buildLiveSnapshot() {
      const soil = getCurrentSoilValues();
      const zoneKey = document.getElementById("zoneSelect").value;
      const seasonKey = document.getElementById("seasonSelect").value;
      const snap = {
        ui_language: state.lang,
        selected_zone: zoneKey,
        icar_zone: state.bootstrap?.regions[zoneKey]?.zone || "",
        selected_season: seasonKey,
        manual_city_search: document.getElementById("citySearchInput").value.trim() || null,
        soil_input_method: state.soilMethod,
        soil_values: soil,
        soil_health_alerts: state.soilAlerts,
        weather_values: {
          temperature_C: parseFloat(document.getElementById("inTemp").value),
          humidity_pct: parseFloat(document.getElementById("inHum").value),
          rainfall_mm: parseFloat(document.getElementById("inRain").value),
        },
        prediction_generated: Boolean(state.prediction),
      };
      if (state.soilMethod === "regional") snap.selected_soil_type = document.getElementById("soilTypeSelect").value;
      if (state.soilMethod === "visual") snap.selected_leaf_symptom = document.getElementById("symptomSelect").value;
      if (state.prediction) {
        snap.active_viewed_strategy = state.prediction.strategies[state.activeRankIdx].crop;
        snap.generated_strategies = state.prediction.strategies;
      }
      return snap;
    }

    function toggleChat(force) {
      state.chatOpen = typeof force === "boolean" ? force : !state.chatOpen;
      document.getElementById("chatDrawer").classList.toggle("open", state.chatOpen);
      if (state.chatOpen) {
        renderChatFeed();
        setTimeout(() => document.getElementById("chatInput").focus(), 180);
      }
    }

    function clearChat() {
      state.messages = state.messages.slice(0, 1);
      renderChatFeed();
    }

    function renderChatFeed(showTyping = false) {
      const feed = document.getElementById("chatFeed");
      let html = state.messages
        .map((m, idx) =>
          m.role === "user"
            ? `<div class="c-row user"><div class="c-bub user">${formatMd(m.content, false)}<span class="c-time">${escapeHtml(m.time)}</span></div></div>`
            : `<div class="c-row bot"><div class="c-bot-ico"><i data-lucide="leaf"></i></div><div class="c-bub bot">${formatMd(m.content, true)}<div class="c-meta-foot"><div class="c-msg-tools"><button type="button" class="c-tool-btn" onclick="speakChatMsg(${idx})"><i data-lucide="volume-2"></i> Listen</button><button type="button" class="c-tool-btn" onclick="copyChatMsg(${idx}, this)"><i data-lucide="copy"></i> Copy</button></div><span class="c-time" style="margin-top:0;">${escapeHtml(m.time)}</span></div></div></div>`
        )
        .join("");

      if (showTyping) {
        html += `<div class="c-row bot"><div class="c-bot-ico"><i data-lucide="leaf"></i></div><div class="c-bub bot"><div class="typing"><span></span><span></span><span></span></div></div></div>`;
      }
      feed.innerHTML = html;
      refreshIcons();
      feed.scrollTop = feed.scrollHeight;
    }

    async function sendChatMessage(text, fromVoice = false) {
      const clean = text.trim();
      if (!clean || state.chatBusy) return;

      stopSpeech();
      state.chatBusy = true;
      document.getElementById("chatSendBtn").disabled = true;

      const firstUserIdx = state.messages.findIndex((m) => m.role === "user");
      const historyPayload =
        firstUserIdx >= 0
          ? state.messages.slice(firstUserIdx).slice(-10).map((m) => ({ role: m.role, content: m.content }))
          : [];

      state.messages.push({ role: "user", time: nowClock(), content: clean });
      renderChatFeed(true);

      try {
        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            message: clean,
            history: historyPayload,
            journey: state.journey,
            snapshot: buildLiveSnapshot(),
          }),
        });
        const data = await res.json();
        const reply = data.reply || "माफ़ कीजिए, कोई जवाब नहीं मिला।";
        const spoken = data.spoken_text || reply;
        const vLang = data.voice_lang || (/[\u0900-\u097F]/.test(spoken) ? "hi" : "en");

        state.messages.push({
          role: "assistant",
          time: nowClock(),
          content: reply,
          spoken_text: spoken,
          voice_lang: vLang,
        });

        const voiceSel = document.getElementById("chatVoiceSelect");
        if (voiceSel) {
          if (vLang === "hi" && voiceSel.value.startsWith("en-IN")) voiceSel.value = "hi-IN-MadhurNeural";
          if (vLang === "en" && voiceSel.value.startsWith("hi-IN")) voiceSel.value = "en-IN-PrabhatNeural";
        }

        renderChatFeed(false);
        if (voiceState.autoSpeak) {
          speakText(spoken, vLang, "chat");
        }
      } catch (err) {
        state.messages.push({
          role: "assistant",
          time: nowClock(),
          voice_lang: "hi",
          spoken_text: "सर्वर से संपर्क नहीं हो पाया। कृपया चेक करें कि सर्वर चल रहा है।",
          content: "Server se connection nahi ho paaya. Kripya check karein ki FastAPI `server.py` chal raha hai.",
        });
        renderChatFeed(false);
      } finally {
        state.chatBusy = false;
        document.getElementById("chatSendBtn").disabled = false;
      }
    }

    function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById("chatInput");
      const text = input.value;
      input.value = "";
      sendChatMessage(text);
    }

    function sendQuickPrompt(prompt) {
      sendChatMessage(prompt);
    }

    /* ---------------- APP BOOTSTRAP ---------------- */
    function bindRangePair(numId, rngId) {
      const num = document.getElementById(numId);
      const rng = document.getElementById(rngId);
      num.addEventListener("input", () => {
        rng.value = num.value;
        updatePhBanner();
        refreshSoilAlerts();
      });
      rng.addEventListener("input", () => {
        num.value = rng.value;
        updatePhBanner();
        refreshSoilAlerts();
      });
    }

    async function initApp() {
      applyTheme(state.theme);
      renderChatFeed();
      refreshIcons();

      bindRangePair("inN", "rngN");
      bindRangePair("inP", "rngP");
      bindRangePair("inK", "rngK");
      bindRangePair("inPH", "rngPH");

      ["inTemp", "inHum", "inRain"].forEach((id) =>
        document.getElementById(id).addEventListener("input", updateWeatherInsight)
      );

      document.getElementById("citySearchInput").addEventListener("keydown", (e) => {
        if (e.key === "Enter") { e.preventDefault(); searchCityWeather(); }
      });

      try {
        const res = await fetch("/api/bootstrap");
        state.bootstrap = await res.json();

        const zoneSel = document.getElementById("zoneSelect");
        zoneSel.innerHTML = Object.keys(state.bootstrap.regions)
          .map((k) => `<option value="${escapeHtml(k)}">${escapeHtml(k)}</option>`)
          .join("");

        const seasonSel = document.getElementById("seasonSelect");
        seasonSel.innerHTML = Object.keys(state.bootstrap.seasons)
          .map((k) => `<option value="${escapeHtml(k)}">${escapeHtml(k)}</option>`)
          .join("");

        const soilSel = document.getElementById("soilTypeSelect");
        soilSel.innerHTML = Object.keys(state.bootstrap.soil_archetypes)
          .map((k) => `<option value="${escapeHtml(k)}">${escapeHtml(k)}</option>`)
          .join("");

        const symSel = document.getElementById("symptomSelect");
        symSel.innerHTML = Object.keys(state.bootstrap.visual_symptoms)
          .map((k) => `<option value="${escapeHtml(k)}">${escapeHtml(k)}</option>`)
          .join("");

        zoneSel.addEventListener("change", () => {
          logStep("Changed Agro-Climatic Zone", zoneSel.value);
          updateRegionMeta(true);
        });
        seasonSel.addEventListener("change", () => {
          logStep("Changed Sowing Season", seasonSel.value);
          updateRegionMeta(false);
        });
        soilSel.addEventListener("change", updateSoilTypeInfo);
        symSel.addEventListener("change", updateSymptomInfo);

        updateRegionMeta(true);
        updateSoilTypeInfo();
        updateSymptomInfo();
        logStep("Opened Agri-Predictor Pro", zoneSel.value);
      } catch (err) {
        addNotification("Backend Disconnected", "Start FastAPI with: uvicorn server:app --port 8000");
      }
    }


    /* ---------------- AUTO-SMART AI BUBBLE & DYNAMIC CHIPS ---------------- */
    const smartState = {
      dismissed: false,
      prompt: "Meri screen par abhi kya data hai aur mujhe aage kya karna chahiye?",
      lastKey: "",
    };

    function copyChatMsg(idx, btnEl) {
      const msg = state.messages[idx];
      if (!msg || !navigator.clipboard) return;
      navigator.clipboard.writeText(msg.content).then(() => {
        if (!btnEl) return;
        const prev = btnEl.innerHTML;
        btnEl.innerHTML = '<i data-lucide="check"></i> Copied';
        refreshIcons();
        setTimeout(() => { btnEl.innerHTML = prev; refreshIcons(); }, 1400);
      });
    }

    function speakChatMsg(idx) {
      const msg = state.messages[idx];
      if (!msg) return;
      const textToSay = msg.spoken_text || msg.content;
      const langHint = msg.voice_lang || (/[\u0900-\u097F]/.test(textToSay) ? "hi" : "en");
      speakText(textToSay, langHint);
    }

    function renderDynamicQuickChips() {
      const bar = document.getElementById("chatQuickChips");
      if (!bar) return;
      let chips;
      if (state.prediction) {
        const s = state.prediction.strategies[state.activeRankIdx];
        chips = [
          { icon: "bar-chart-3", label: `Explain ${s.crop}`, prompt: `Mere recommended crop ${s.crop} (${s.match_percent}%) ka result, XAI warnings aur field steps simple Hinglish mein samjhao.` },
          { icon: "wrench", label: `Fix ${s.key_focus_factor}`, prompt: `${s.crop} ke liye mera ${s.key_focus_factor} (${s.key_focus_assessment}) kaise theek karun? Practical desi upay batao.` },
          { icon: "indian-rupee", label: "Mandi Profit", prompt: `${s.crop} ka current Mandi bhav, 14-day forecast aur best selling strategy Hinglish mein batao.` },
        ];
      } else {
        const { ph } = getCurrentSoilValues();
        chips = [
          { icon: "flask-conical", label: "Soil Help", prompt: `Mere current soil values (pH ${Number(ph).toFixed(1)}) ka kya matlab hai? Kya koi sudhar zaroori hai?` },
          { icon: "compass", label: "Next Step", prompt: "Maine abhi tak website par kya kiya hai aur mujhe aage kya karna chahiye?" },
          { icon: "sprout", label: "Best Season", prompt: "Mere selected ICAR zone aur season ke hisaab se kaunsi faslein sabse zyada profitable hoti hain?" },
        ];
      }
      bar.innerHTML = chips
        .map((c, i) => `<button type="button" class="chat-chip" data-chip-idx="${i}"><i data-lucide="${c.icon}"></i> ${escapeHtml(c.label)}</button>`)
        .join("");
      bar.querySelectorAll(".chat-chip").forEach((btn, i) => {
        btn.addEventListener("click", () => sendQuickPrompt(chips[i].prompt));
      });
      refreshIcons();
    }

    function showSmartBubble({ key, level, icon, title, text, badge, prompt, forceShow = false }) {
      const el = document.getElementById("smartBubble");
      const fab = document.getElementById("chatFab");
      const fabBadge = document.getElementById("fabBadge");
      const mDot = document.getElementById("mAdvisorDot");
      if (!el) return;

      smartState.prompt = prompt;
      if (forceShow && key !== smartState.lastKey) smartState.dismissed = false;
      smartState.lastKey = key;

      el.className = `smart-bubble-wrap ${level || ""}`;
      document.getElementById("sbIcon").innerHTML = `<i data-lucide="${icon || "sparkles"}"></i>`;
      document.getElementById("sbTitle").textContent = title;
      document.getElementById("sbText").textContent = text;

      if (fabBadge) {
        fabBadge.textContent = badge || "Smart Tip";
        fabBadge.classList.add("show");
      }
      if (fab) fab.classList.toggle("has-alert", level === "warn" || level === "danger");
      if (mDot) mDot.classList.add("show");

      if (!state.chatOpen && !smartState.dismissed) {
        el.classList.add("show");
      }
      refreshIcons();
    }

    function dismissSmartBubble(e) {
      if (e) e.stopPropagation();
      smartState.dismissed = true;
      const el = document.getElementById("smartBubble");
      if (el) el.classList.remove("show");
    }

    function triggerSmartBubblePrompt() {
      dismissSmartBubble();
      toggleChat(true);
      sendQuickPrompt(smartState.prompt);
    }

    function updateSmartBubble(trigger = "auto") {
      renderDynamicQuickChips();
      if (state.prediction && (trigger === "prediction" || trigger === "tab" || trigger === "auto")) {
        const s = state.prediction.strategies[state.activeRankIdx];
        const lowRow = s.xai.find((r) => r.status === "low");
        if (lowRow) {
          showSmartBubble({
            key: `pred-low-${s.crop}-${lowRow.factor}`,
            level: "danger",
            icon: "alert-triangle",
            title: `Action Alert • ${s.crop}`,
            text: `${lowRow.factor} is below ideal (${lowRow.field_value}). Tap for a quick field fix!`,
            badge: "Fix Alert",
            prompt: `${s.crop} mein mera ${lowRow.factor} (${lowRow.field_value}) kam dikha raha hai. Isko theek karne ke practical aur saste upay batao.`,
            forceShow: trigger === "prediction" || trigger === "tab",
          });
          return;
        }
        showSmartBubble({
          key: `pred-ok-${s.crop}`,
          level: "",
          icon: "trending-up",
          title: `${s.crop} (${s.match_percent}%) Ready`,
          text: `Live Mandi ₹${Math.round(s.mandi.current_price)}/Q • ${s.mandi.sentiment}. Tap for profit plan!`,
          badge: "Profit Tip",
          prompt: `Mere recommended crop ${s.crop} ka Mandi bhav, 14-day forecast aur profit strategy simple Hinglish mein samjhao.`,
          forceShow: trigger === "prediction" || trigger === "tab",
        });
        return;
      }

      if (trigger === "weather") {
        const t = document.getElementById("inTemp").value;
        const h = document.getElementById("inHum").value;
        showSmartBubble({
          key: `weather-${t}-${h}`,
          level: "",
          icon: "satellite",
          title: "Weather Telemetry Synced",
          text: `${t}°C & ${h}% humidity loaded. Want to know which crops fit this climate?`,
          badge: "Weather",
          prompt: `Abhi mere screen par ${t}°C temperature aur ${h}% humidity hai. Is mausam ke liye kaunsi faslein best rahengi?`,
          forceShow: true,
        });
        return;
      }

      const { ph } = getCurrentSoilValues();
      if (ph < 6.0 || ph > 7.5) {
        const kind = ph < 6.0 ? "Acidic" : "Alkaline";
        showSmartBubble({
          key: `ph-${kind}`,
          level: "warn",
          icon: "flask-conical",
          title: `${kind} Soil Detected (pH ${Number(ph).toFixed(1)})`,
          text: "Soil pH is outside 6.0–7.5 ideal range. Tap for a quick soil balance guide!",
          badge: "pH Alert",
          prompt: `Meri mitti ka pH ${Number(ph).toFixed(1)} (${kind}) hai. Isko balance karne aur N-P-K uptake badhane ke liye kya karun?`,
          forceShow: trigger === "soil",
        });
        return;
      }

      if (trigger === "init") {
        showSmartBubble({
          key: "welcome-smart",
          level: "",
          icon: "sparkles",
          title: "Kisan Sahayak AI Ready",
          text: "Need help entering Soil Report values or checking live Mandi rates? Tap anytime!",
          badge: "AI Ready",
          prompt: "Namaste! Mujhe Agri-Predictor Pro kaise use karna hai aur apni mitti ke liye best fasal kaise pata karun?",
          forceShow: true,
        });
      }
    }

    // Hook Auto-Smart Bubble seamlessly into existing app events
    const _origToggleChat = toggleChat;
    toggleChat = function(force) {
      _origToggleChat(force);
      if (state.chatOpen) {
        const el = document.getElementById("smartBubble");
        if (el) el.classList.remove("show");
        const mDot = document.getElementById("mAdvisorDot");
        if (mDot) mDot.classList.remove("show");
        renderDynamicQuickChips();
      }
    };

    const _origUpdatePhBanner = updatePhBanner;
    updatePhBanner = function() {
      _origUpdatePhBanner();
      if (state.bootstrap) updateSmartBubble("soil");
    };

    const _origFetchSat = fetchSatelliteWeather;
    fetchSatelliteWeather = async function(...args) {
      const r = await _origFetchSat.apply(this, args);
      updateSmartBubble("weather");
      return r;
    };

    const _origLockPrayag = lockPrayagraj;
    lockPrayagraj = async function(...args) {
      const r = await _origLockPrayag.apply(this, args);
      updateSmartBubble("weather");
      return r;
    };

    const _origSearchCity = searchCityWeather;
    searchCityWeather = async function(...args) {
      const r = await _origSearchCity.apply(this, args);
      updateSmartBubble("weather");
      return r;
    };

    const _origGenerate = generateMasterStrategy;
    generateMasterStrategy = async function(...args) {
      const r = await _origGenerate.apply(this, args);
      updateSmartBubble("prediction");
      return r;
    };

    const _origSelectStrategy = selectStrategy;
    selectStrategy = function(idx) {
      _origSelectStrategy(idx);
      updateSmartBubble("tab");
    };

    const _origInitApp = initApp;
    initApp = async function() {
      await _origInitApp();
      initAutoSlideSwitch();
      setTimeout(() => updateSmartBubble("init"), 900);
    };


